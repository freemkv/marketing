---
import { graph, websiteNode, orgNode, appNode, webPageNode, breadcrumbNode, ID } from '../lib/jsonld.mjs';
// Standalone styled Download page for freemkv.org.
// Owns the "/download" route directly (NOT part of the Starlight docs
// collection) so it shares the landing page's visual language with full
// design freedom.
//
// ── How downloads work ─────────────────────────────────────────────
// Every link here is a plain GitHub release-asset URL. By default they
// use the version-less `releases/latest/download/<asset>` form, which
// always resolves to the newest release, works with JS disabled.
//
// A client-side script (see the inline <script> below) progressively
// enhances the page:
//   1. OS/arch auto-detection (busbar-style) highlights the binary that
//      matches the visitor's platform and pre-selects it.
//   2. A version picker queries the GitHub Releases API and lets the
//      visitor pin downloads to a specific tag. The API response is
//      cached in localStorage with a TTL to respect the unauthenticated
//      rate limit (60 req/hr/IP). If the API fails, the picker stays on
//      "latest" and a link to the GitHub releases page is shown.
//
// Asset names below MUST match what the release workflows attach.
// freemkv ships as two builds of one program; install one OR the other:
//   app (freemkv):     window + every CLI command
//   CLI (freemkv-cli): command line only, no desktop dependencies
//   freemkv-library:   Docker image only (no binary assets)
const title = 'Download freemkv: Windows, macOS & Linux';
const description =
  'Download the freemkv app or the freemkv CLI for Windows, macOS, and Linux (Intel & ARM), plus freemkv-library (Docker). Free & open source. Or build from source.';

const docs = '/docs/overview/';
const github = 'https://github.com/freemkv';
const cliRepo = 'https://github.com/freemkv/freemkv';
// App and CLI are both built from the `freemkv` repo.
const guiRepo = cliRepo;
const allReleases = `${cliRepo}/releases`;

// Card data for the app and CLI sections: one box per install method.
// `key` ("<os>-<arch>") marks the button the detector highlights;
// `secondary` renders an outline button; `commands` are copy-paste shell lines.
import { aptSetup, rpmSetup, pacmanSetup, scoopSetup, linuxHelp, windowsHelp } from '../lib/install-commands.mjs';

const appPlatforms = [
  {
    name: 'Windows',
    os: 'windows',
    methods: [
      {
        title: 'Scoop',
        hint: 'x86_64 and ARM64 · updates with scoop update',
        commands: [scoopSetup, 'scoop install freemkv'],
      },
      {
        title: 'Download',
        builds: [
          { key: 'windows-x64', main: 'Installer', arch: 'x86_64', label: 'Adds freemkv to PATH · Start menu shortcut', file: 'freemkv-x86_64-windows-setup.exe' },
          { main: 'Portable', arch: '.zip', label: 'freemkv.exe + freemkv.com, no install', file: 'freemkv-x86_64-windows.zip', secondary: true },
          { key: 'windows-arm64', main: 'Installer', arch: 'ARM64', label: 'Windows on ARM · Snapdragon / Surface', file: 'freemkv-aarch64-windows-setup.exe', secondary: true },
          { main: 'Portable', arch: 'ARM64 .zip', label: 'Windows on ARM, no install', file: 'freemkv-aarch64-windows.zip', secondary: true },
        ],
      },
    ],
    footnote: windowsHelp,
  },
  {
    name: 'macOS',
    os: 'macos',
    methods: [
      {
        title: 'Homebrew',
        hint: 'Apple Silicon or Intel',
        commands: ['brew install --cask freemkv/tap/freemkv'],
        note: 'Installs the app and the <code>freemkv</code> command. freemkv is not notarized, so on macOS it installs through Homebrew only, which skips the security prompt a browser download would hit.',
      },
    ],
  },
  {
    name: 'Linux',
    os: 'linux',
    methods: [
      {
        title: 'APT',
        hint: 'Ubuntu 24.04+, Mint 22, Debian 13 · recommended',
        commands: [...aptSetup, 'sudo apt update && sudo apt install freemkv'],
        note: 'Updates arrive with <code>apt upgrade</code>.',
      },
      {
        title: 'DNF',
        hint: 'Fedora 40+',
        commands: [rpmSetup, 'sudo dnf install freemkv'],
        note: 'openSUSE: <code>sudo zypper addrepo https://freemkv.org/rpm/freemkv.repo</code>, then <code>sudo zypper install freemkv</code>.',
      },
      {
        title: 'pacman',
        hint: 'Arch Linux',
        commands: [...pacmanSetup, 'sudo pacman -Syu freemkv'],
      },
      {
        title: 'Snap',
        hint: 'any distro with snapd',
        commands: ['sudo snap install freemkv', 'sudo snap connect freemkv:optical-drive', 'sudo snap connect freemkv:optical-write'],
      },
      {
        title: 'FlatPark',
        hint: 'Flatpak repository · any distro · includes Ubuntu 22.04',
        commands: [
          'flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo',
          'flatpak remote-add --if-not-exists flatpark https://dl.flatpark.org/flatpark.flatpakrepo',
          'flatpak install flatpark org.freemkv.FreeMKV',
        ],
        note: 'Updates arrive with <code>flatpak update</code>.',
      },
      {
        title: 'Download',
        builds: [
          { key: 'linux-x64', arch: '.deb', label: 'Ubuntu 24.04+ / Mint 22 / Debian 13 · x86_64', file: 'freemkv-amd64.deb' },
          { key: 'linux-arm64', arch: 'ARM64 .deb', label: 'Debian 13 / Ubuntu 24.04+ · aarch64', file: 'freemkv-arm64.deb', secondary: true },
          { arch: 'AppImage', label: 'Portable · x86_64 · GTK 4.10+', file: 'freemkv-x86_64-linux.AppImage', secondary: true },
          { arch: 'ARM64 AppImage', label: 'Portable · aarch64 · GTK 4.10+', file: 'freemkv-aarch64-linux.AppImage', secondary: true },
          { arch: '.flatpak', label: 'Bundle file · x86_64 · any distro, no auto-updates', file: 'freemkv-x86_64-linux.flatpak', secondary: true },
        ],
        note: 'The .deb and AppImage need GTK 4.10+; on Ubuntu 22.04 or Mint 21 use FlatPark, Snap or the .flatpak. Installing the .flatpak: <a href="/docs/platforms-linux/#direct-flatpak-bundle">Linux guide</a>.',
      },
    ],
    footnote: linuxHelp,
  },
];

const cliPlatforms = [
  {
    name: 'Windows',
    os: 'windows',
    methods: [
      {
        title: 'Scoop',
        hint: 'x86_64 and ARM64 · updates with scoop update',
        commands: [scoopSetup, 'scoop install freemkv-cli'],
      },
      {
        title: 'Download',
        builds: [
          { key: 'windows-x64', arch: 'x86_64', label: 'Console .exe · rename to freemkv.exe', file: 'freemkv-cli-x86_64-windows.exe' },
          { key: 'windows-arm64', arch: 'ARM64', label: 'Windows on ARM · rename to freemkv.exe', file: 'freemkv-cli-aarch64-windows.exe', secondary: true },
        ],
      },
    ],
    footnote: windowsHelp,
  },
  {
    name: 'macOS',
    os: 'macos',
    methods: [
      {
        title: 'Homebrew',
        hint: 'Apple Silicon or Intel',
        commands: ['brew install freemkv/tap/freemkv-cli'],
      },
    ],
  },
  {
    name: 'Linux',
    os: 'linux',
    methods: [
      {
        title: 'APT',
        hint: 'Debian, Ubuntu 22.04+, Mint · recommended',
        commands: [...aptSetup, 'sudo apt update && sudo apt install freemkv-cli'],
      },
      {
        title: 'DNF',
        hint: 'Fedora, RHEL 9, Alma, Rocky',
        commands: [rpmSetup, 'sudo dnf install freemkv-cli'],
        note: 'openSUSE: <code>sudo zypper addrepo https://freemkv.org/rpm/freemkv.repo</code>, then <code>sudo zypper install freemkv-cli</code>.',
      },
      {
        title: 'pacman',
        hint: 'Arch Linux',
        commands: [...pacmanSetup, 'sudo pacman -Syu freemkv-cli'],
      },
      {
        title: 'Download',
        builds: [
          { key: 'linux-x64', arch: 'x86_64', label: 'Static binary · any distro', file: 'freemkv-cli-x86_64-linux' },
          { key: 'linux-arm64', arch: 'ARM64', label: 'Static binary · aarch64, Raspberry Pi OS 64-bit', file: 'freemkv-cli-aarch64-linux', secondary: true },
          { arch: 'ARMv7', label: 'Static binary · Raspberry Pi OS 32-bit', file: 'freemkv-cli-armv7-linux', secondary: true },
          { arch: '.deb', label: 'x86_64 · package freemkv-cli', file: 'freemkv-cli-amd64.deb', secondary: true },
          { arch: 'ARM64 .deb', label: 'aarch64 · package freemkv-cli', file: 'freemkv-cli-arm64.deb', secondary: true },
          { arch: 'armhf .deb', label: 'Raspberry Pi OS 32-bit · package freemkv-cli', file: 'freemkv-cli-armhf.deb', secondary: true },
        ],
      },
    ],
    footnote: linuxHelp,
  },
];

import DownloadCards from '../components/DownloadCards.astro';
import FirmwareNavDropdown from '../components/FirmwareNavDropdown.astro';
import '../styles/site.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://freemkv.org/download/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://freemkv.org/freemkv-icon.svg" />
    <meta property="og:url" content="https://freemkv.org/download/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://freemkv.org/freemkv-icon.svg" />
    <script type="application/ld+json" set:html={graph(webPageNode({ path: '/download/', name: title, description, about: ID.app }), breadcrumbNode('/download/', [['freemkv', '/'], ['Download', '/download/']]), websiteNode(), orgNode(), appNode())} />
  </head>
  <body class="page-download">
    <!-- ============ STICKY NAV ============ -->
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">
          <img src="/freemkv-icon.svg" alt="" width="32" height="32" />
          <span>freemkv</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={docs}>Docs</a>
          <a href="/download/" aria-current="page">Software</a>
          <FirmwareNavDropdown />
          <a
            class="nav-discord"
            href="https://discord.gg/yu7xMGTyek"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
          >
            <svg class="nav-discord-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.956-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.956 2.42-2.157 2.42zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.946 2.42-2.157 2.42z"/></svg>
          </a>
          <a
            class="gh-stars"
            href="https://github.com/freemkv/freemkv"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub stars"
            data-gh-repo="freemkv/freemkv"
          >
            <span class="gh-stars-num"><span data-gh-stars hidden></span>★</span>
            <svg class="gh-stars-logo" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero-inner">
          <img class="hero-logo" src="/freemkv-icon.svg" alt="freemkv" width="80" height="80" />
          <h1 class="hero-title">Download freemkv</h1>
          <div class="hero-version">
            <span class="hero-version-dot" aria-hidden="true"></span>
            <span class="hero-version-label">Latest release</span>
            <span class="hero-version-num" data-latest-version>v1.8.0</span>
          </div>
          <div class="hero-version-date" data-latest-date>October 5, 2026</div>
          <p class="hero-foot">Free &amp; open source · Windows, macOS &amp; Linux · Intel &amp; ARM</p>
        </div>
      </section>

      <!-- ============ APP ============ -->
      <section class="downloads" id="gui">
        <div class="section-inner">
          <h2 class="section-title">freemkv</h2>
          <p class="section-lead">
            The app, for Windows, macOS and Linux: open a disc or an image, tick the
            titles and tracks you want, press Rip. It includes every CLI command too, so <code>freemkv disc:// mkv://Movie.mkv</code> works in a terminal and a
            bare <code>freemkv</code> opens the window.
          </p>

          <!-- Version picker + detected-platform banner (JS-enhanced) -->
          <div class="dl-toolbar" data-dl-toolbar>
            <div class="dl-detected-banner" data-detected-banner hidden>
              <span class="dl-detected-eyebrow">Detected</span>
              <span data-detected-label>your platform</span>
            </div>
            <label class="dl-version-pick" hidden data-version-pick>
              <span class="dl-version-label">Version</span>
              <select data-version-select aria-label="Choose release version">
                <option value="latest">Latest</option>
              </select>
            </label>
          </div>

          <DownloadCards platforms={appPlatforms} repo={guiRepo} />
          <p class="dl-note">
            Install the app <strong>or</strong> the CLI, not both: they are the same <code>freemkv</code> command and each replaces the other. <a href="/docs/platforms-macos/#apple-could-not-verify-freemkv-on-first-launch">Why Homebrew on macOS →</a>
          </p>
        </div>
      </section>

      <!-- ============ CLI ============ -->
      <section class="downloads" id="cli">
        <div class="section-inner">
          <h2 class="section-title">freemkv CLI</h2>
          <p class="section-lead">
            Command line only, with no desktop dependencies: for servers, scripts
            and SSH sessions. Windows, macOS &amp; Linux (Intel &amp; ARM).
          </p>

          <!-- Version picker + detected-platform banner (JS-enhanced) -->
          <div class="dl-toolbar" data-dl-toolbar>
            <div class="dl-detected-banner" data-detected-banner hidden>
              <span class="dl-detected-eyebrow">Detected</span>
              <span data-detected-label>your platform</span>
            </div>
            <label class="dl-version-pick" hidden data-version-pick>
              <span class="dl-version-label">Version</span>
              <select data-version-select aria-label="Choose release version">
                <option value="latest">Latest</option>
              </select>
            </label>
          </div>

          <DownloadCards platforms={cliPlatforms} repo={cliRepo} />
          <p class="dl-note">
            Every asset has a matching <code>.sha256</code> checksum on the release page.
            Prefer another version? <a href={allReleases} data-all-releases>All releases on GitHub →</a>
          </p>
        </div>
      </section>

      <!-- ============ FREEMKV-LIBRARY ============ -->
      <section class="block block-alt" id="library">
        <span id="autorip"></span>
        <div class="section-inner">
          <h2 class="section-title">freemkv-library</h2>
          <p class="section-lead">
            The freemkv web server, for hands-off ripping: insert a disc and it rips the main
            movie automatically to MKV. A Library tab lists your MKVs and ISOs side by side,
            shows which freemkv version made each MKV, and remuxes out-of-date titles from
            their ISO. Replaces autorip. Ships as a <strong>Docker image</strong>; the download
            buttons above never include the server.
          </p>

          <div class="dl-library-bin">
            <h3 class="dl-bin-title">Run via Docker</h3>
            <p class="dl-bin-lead">
              The image is on GHCR (<code>:latest</code> and <code>:vX.Y.Z</code>).
              <code>--privileged</code> is required for optical SCSI access.
            </p>
            <div class="terminal">
              <div class="terminal-bar" aria-hidden="true">
                <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
                <span class="terminal-title">docker</span>
              </div>
              <pre class="terminal-body"><code><span class="c"># Then open http://&lt;host&gt;:8080 in your browser</span>
<span class="p">$</span> docker run --privileged -v /dev:/dev \
      -v ./keys:/root/.config/freemkv \
      -p 8080:8080 \
      ghcr.io/freemkv/freemkv-library:latest</code></pre>
            </div>
          </div>
          <p class="block-note">
            Upgrading from autorip? Pull the new image: your <code>/config/settings.json</code>
            and <code>AUTORIP_*</code> variables work unchanged, and the same image is still
            published as <code>ghcr.io/freemkv/autorip</code>. It rips the main movie only; for
            other titles use the CLI or the desktop app.
            <a href="/docs/library/#deploy">Setup, keys and drive permissions →</a>
          </p>
        </div>
      </section>

      <!-- ============ BUILD FROM SOURCE ============ -->
      <section class="block block-alt" id="source">
        <div class="section-inner">
          <h2 class="section-title">Build from source</h2>
          <p class="section-lead">
            Pure Rust, single binary. Clone the repo and build with Cargo.
          </p>
          <div class="terminal">
            <div class="terminal-bar" aria-hidden="true">
              <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
              <span class="terminal-title">build</span>
            </div>
            <pre class="terminal-body"><code><span class="c"># Clone and build the workspace</span>
<span class="p">$</span> git clone https://github.com/freemkv/freemkv.git
<span class="p">$</span> cd freemkv
<span class="p">$</span> cargo build --release                  <span class="c"># CLI</span>
<span class="p">$</span> cargo build --release --features gui   <span class="c"># app</span>

<span class="c"># Binary at target/release/freemkv</span>
<span class="p">$</span> ./target/release/freemkv --version</code></pre>
          </div>
          <div class="cta-row after-cta">
            <a class="btn btn-primary" href="/docs/overview/">Get started →</a>
            <a class="btn btn-secondary" href="/docs/install/">Install docs</a>
          </div>
        </div>
      </section>

    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="section-inner footer-inner">
        <div class="footer-brand">
          <img src="/freemkv-icon.svg" alt="" width="28" height="28" />
          <span>freemkv</span>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={github}>GitHub</a>
          <a href="https://github.com/orgs/freemkv/packages/container/package/freemkv-library">GHCR (freemkv-library)</a>
          <a href="https://github.com/freemkv/freemkv/blob/main/LICENSE">License (MIT)</a>
        </nav>
      </div>
      <p class="footer-copy">MIT · Recover 100% of readable data from any optical disc.</p>
    </footer>

    <script is:inline define:vars={{ cliRepo, allReleases }}>
      // Progressive enhancement only. With JS disabled, every link is a
      // plain `releases/latest/download/<asset>` URL and still works.
      (function () {
        // ---- 1. OS / arch detection (busbar-style) -------------------
        // Returns a key matching the build's data-key, e.g. "macos-arm64".
        function detect() {
          var uad = navigator.userAgentData || null;
          var ua = (navigator.userAgent || '') + ' ' + (navigator.platform || '');
          var os = '';
          if (uad && uad.platform) {
            var p = uad.platform.toLowerCase();
            if (/win/.test(p)) os = 'windows';
            else if (/mac/.test(p)) os = 'macos';
            else if (/linux|android|chrome os/.test(p)) os = 'linux';
          }
          if (!os) {
            os = /Win/i.test(ua) ? 'windows'
              : /Mac|iPhone|iPad/i.test(ua) ? 'macos'
              : /Linux|Android/i.test(ua) ? 'linux' : '';
          }
          if (!os) return null;

          // Arch. Apple Silicon Macs report "Intel" in UA for compat, so
          // treat modern macOS as arm64 unless we can prove x64.
          var arch = '';
          var archHint = (uad && uad.architecture ? uad.architecture : '').toLowerCase();
          if (archHint) {
            arch = /arm|aarch/.test(archHint) ? 'arm64' : 'x64';
          } else if (/aarch64|arm64/i.test(ua)) {
            arch = 'arm64';
          } else if (os === 'macos') {
            // navigator.platform "MacIntel" is reported by both; default
            // to Apple Silicon (the common case for new downloads).
            arch = 'arm64';
          } else {
            arch = 'x64';
          }
          if (os === 'windows' && arch !== 'arm64') arch = 'x64'; // UA hides Windows on ARM unless hinted
          return os + '-' + arch;
        }

        var detectedKey = detect();
        var detectedOs = detectedKey ? detectedKey.split('-')[0] : '';

        // Highlight the matching OS card + the matching arch button.
        if (detectedOs) {
          document.querySelectorAll('.card[data-os="' + detectedOs + '"]').forEach(function (c) {
            c.classList.add('is-detected');
          });
        }
        if (detectedKey) {
          document.querySelectorAll('[data-key="' + detectedKey + '"]').forEach(function (b) {
            b.classList.add('is-match');
          });
          var pretty = {
            'macos-arm64': 'macOS · Apple Silicon', 'macos-x64': 'macOS · Intel',
            'linux-x64': 'Linux · x86_64', 'linux-arm64': 'Linux · aarch64',
            'windows-x64': 'Windows · x86_64', 'windows-arm64': 'Windows · ARM64',
          };
          if (pretty[detectedKey]) {
            // Light up every toolbar's banner.
            document.querySelectorAll('[data-detected-banner]').forEach(function (banner) {
              var label = banner.querySelector('[data-detected-label]');
              if (label) {
                label.textContent = pretty[detectedKey];
                banner.hidden = false;
              }
            });
          }
        }

        // ---- 2. Version picker (GitHub Releases API + localStorage) --
        var CACHE_KEY = 'freemkv-releases-v2';
        var TTL_MS = 6 * 60 * 60 * 1000; // 6h, well under the 60/hr limit
        var API = 'https://api.github.com/repos/freemkv/freemkv/releases?per_page=30';

        // Rewrite every asset link for the chosen tag. "latest" → the
        // version-less URL; a concrete tag → .../download/<tag>/<asset>.
        // tag -> Set of asset names actually attached to that release, filled
        // from the same API response that populates the picker.
        //
        // WHY: asset names have changed over time. v1.5.2 shipped no macOS
        // app (releases v1.7.x shipped a .dmg; 1.8.0 dropped it), and no x86_64 macOS CLI binary. Building every link from the
        // CURRENT naming meant picking an older version handed the visitor a
        // download button that 404s — silently, because nothing here checked
        // the release actually had the file. The API already returns the asset
        // list, so a button can be disabled instead of lying.
        var assetsByTag = Object.create(null);

        function markUnavailable(a, unavailable) {
          if (unavailable) {
            a.setAttribute('data-unavailable', '');
            a.removeAttribute('href');
          } else {
            a.removeAttribute('data-unavailable');
          }
        }

        // A card whose every button is hidden must say so rather than render as
        // an empty box. The desktop app did not exist before 1.6.0, so choosing
        // an older version legitimately leaves the macOS and Windows app cards
        // with nothing to offer.
        function syncEmptyCards() {
          document.querySelectorAll('[data-platform-card]').forEach(function (card) {
            var links = card.querySelectorAll('a[data-asset]');
            if (!links.length) return;
            var hidden = card.querySelectorAll('a[data-asset][data-unavailable]').length;
            var empty = hidden === links.length;
            card.toggleAttribute('data-card-empty', empty);
            var note = card.querySelector('[data-none-note]');
            if (!note && empty) {
              note = document.createElement('p');
              note.className = 'dl-none';
              note.setAttribute('data-none-note', '');
              note.textContent = 'Not released for this version.';
              card.appendChild(note);
            }
            if (note) note.hidden = !empty;
          });
        }

        function applyVersion(tag) {
          var known = assetsByTag[tag];
          document.querySelectorAll('a[data-asset]').forEach(function (a) {
            var asset = a.getAttribute('data-asset');
            // Only judge when the release's real asset list is known; with no
            // data (API down, cache miss) leave the link alone rather than
            // disabling a download that probably works.
            if (known && !known[asset]) { markUnavailable(a, true); return; }
            markUnavailable(a, false);
            // The desktop app and the CLI are the SAME binary in the SAME repo
            // (freemkv), so every freemkv asset — .zip, bare binary, .exe
            // — resolves against cliRepo. (There is no longer a "freemkv-gui-*"
            // asset family; that naming was retired when the GUI and CLI merged
            // into one binary. `guiRepo === cliRepo`.)
            a.href = tag === 'latest'
              ? cliRepo + '/releases/latest/download/' + asset
              : cliRepo + '/releases/download/' + tag + '/' + asset;
          });
          var all = document.querySelector('[data-all-releases]');
          if (all) {
            all.href = tag === 'latest' ? allReleases : cliRepo + '/releases/tag/' + tag;
          }
          syncEmptyCards();
        }

        // Format an ISO date (release tag date) as e.g. "July 1, 2026".
        function fmtDate(iso) {
          if (!iso) return '';
          var d = new Date(iso);
          if (isNaN(d.getTime())) return '';
          return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        }

        function populate(tags, latestDate) {
          if (!tags || !tags.length) return;
          // The baked static badge is ALREADY the latest release (the release
          // script bakes it in), so the API call only VERIFIES it. Rewrite the
          // text only when it genuinely differs — a no-op avoids the version/date
          // "flash" on load when the static is already correct.
          document.querySelectorAll('[data-latest-version]').forEach(function (el) {
            if (el.textContent !== tags[0]) el.textContent = tags[0];
          });
          if (latestDate) {
            document.querySelectorAll('[data-latest-date]').forEach(function (el) {
              if (el.textContent !== latestDate) el.textContent = latestDate;
            });
          }
          // Populate every toolbar's picker. Each select
          // drives the same global applyVersion, so changing either one
          // rewrites all asset links across both sections.
          document.querySelectorAll('[data-version-pick]').forEach(function (pick) {
            var sel = pick.querySelector('[data-version-select]');
            if (!sel) return;
            tags.forEach(function (t) {
              var o = document.createElement('option');
              o.value = t; o.textContent = t;
              sel.appendChild(o);
            });
            sel.addEventListener('change', function () { applyVersion(sel.value); });
            pick.hidden = false;
          });
          // Judge the CURRENT selection now that the asset lists are known —
          // otherwise the default "latest" view keeps whatever the static HTML
          // shipped, and a retired asset stays clickable until someone changes
          // the dropdown.
          var first = document.querySelector('[data-version-select]');
          applyVersion(first && first.value ? first.value : 'latest');
        }

        function readCache() {
          try {
            var raw = localStorage.getItem(CACHE_KEY);
            if (!raw) return null;
            var obj = JSON.parse(raw);
            if (!obj || (Date.now() - obj.t) > TTL_MS) return null;
            return obj;
          } catch (e) { return null; }
        }

        // Always fetch fresh so the badge reflects the TRUE latest release; the
        // cache is only an offline/rate-limit fallback. (A stale cache must never
        // downgrade the badge below the real latest, that was the rc1-after-rc2 bug.)
        var cached = readCache();
        fetch(API, { headers: { Accept: 'application/vnd.github+json' } })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
          .then(function (rels) {
            var list = (rels || []).filter(function (r) { return !r.draft; });
            var tags = list.map(function (r) { return r.tag_name; });
            list.forEach(function (r) {
              var set = Object.create(null);
              (r.assets || []).forEach(function (as) { set[as.name] = true; });
              assetsByTag[r.tag_name] = set;
            });
            // "latest" resolves to the newest release, so it shares its assets.
            if (tags.length) assetsByTag.latest = assetsByTag[tags[0]];
            if (!tags.length) { if (cached) populate(cached.tags, cached.date); return; }
            // The newest release's date (published_at, falling back to the tag's
            // created_at) — shown under the version and backfilled into the cache.
            var latestDate = fmtDate(list[0].published_at || list[0].created_at);
            try {
              localStorage.setItem(CACHE_KEY, JSON.stringify({ t: Date.now(), tags: tags, date: latestDate }));
            } catch (e) { /* private mode / quota, non-fatal */ }
            populate(tags, latestDate);
          })
          .catch(function () {
            // API failed (rate-limit, offline). Fall back to the cached list if
            // present; otherwise the static badge + date + latest/download links stand.
            if (cached) populate(cached.tags, cached.date);
          });
      })();

      // Live GitHub star count for the nav "N★ GitHub" link. Cached in
      // localStorage (1h TTL) to stay under the unauthenticated rate limit.
      // On failure the link stays as "★ GitHub" with no number, never "NaN".
      (function () {
        var el = document.querySelector('a.gh-stars');
        if (!el) return;
        var repo = el.dataset.ghRepo;
        var countEl = el.querySelector('[data-gh-stars]');
        if (!repo || !countEl) return;
        var CACHE_KEY = 'freemkv:gh-stars:' + repo;
        var TTL_MS = 60 * 60 * 1000;
        function format(n) {
          if (!isFinite(n) || n < 0) return '';
          if (n < 1000) return String(n);
          var k = n / 1000;
          var s = k < 10 ? k.toFixed(1) : Math.round(k).toString();
          return s.replace(/\.0$/, '') + 'k';
        }
        function show(n) {
          var text = format(n);
          if (!text) return;
          countEl.textContent = text;
          countEl.hidden = false;
          el.setAttribute('aria-label', 'GitHub stars: ' + n.toLocaleString());
        }
        try {
          var raw = localStorage.getItem(CACHE_KEY);
          if (raw) {
            var cached = JSON.parse(raw);
            if (cached && typeof cached.count === 'number') {
              show(cached.count);
              if (Date.now() - cached.ts < TTL_MS) return;
            }
          }
        } catch (e) {}
        fetch('https://api.github.com/repos/' + repo, {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
          .then(function (data) {
            var count = data && data.stargazers_count;
            if (typeof count !== 'number') return;
            show(count);
            try { localStorage.setItem(CACHE_KEY, JSON.stringify({ count: count, ts: Date.now() })); } catch (e) {}
          })
          .catch(function () {});
      })();
    </script>

  </body>
</html>
