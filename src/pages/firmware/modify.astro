      /* ---------- NEXT-STEP LINK (Find → Modify → Flash journey) ---------- */
      .next-step {
        margin: 2.5rem auto 0;
        text-align: center;
      }
      .next-step-link {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.7rem 1.4rem;
        border: 1.5px solid var(--line);
        border-radius: 999px;
        font-weight: 650;
        font-size: 1rem;
        color: var(--teal-dark);
        text-decoration: none;
        transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
      }
      .next-step-link span { transition: transform 0.15s ease; }
      .next-step-link:hover,
      .next-step-link:focus-visible {
        color: var(--teal-darker);
        border-color: var(--teal);
        background: var(--teal-tint);
      }
      .next-step-link:hover span,
      .next-step-link:focus-visible span { transform: translateX(3px); }

      /* ---------- FREEMKV-FW CAPABILITY GRID ---------- */
      .cap-grid {
        margin: 2rem auto 1.5rem;
        max-width: 900px;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      }
      .cap-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 1rem 1.1rem;
        background: var(--bg-soft);
        border: 1px solid var(--line);
        border-radius: 10px;
        text-align: left;
      }
      .cap-dot {
        flex: none;
        width: 0.6rem;
        height: 0.6rem;
        margin-top: 0.35rem;
        border-radius: 999px;
      }
      .cap-dot-ready { background: var(--teal); }
      .cap-dot-wip { background: #f59e0b; }
      .cap-body { display: flex; flex-direction: column; gap: 0.15rem; }
      .cap-name {
        font-weight: 700;
        color: var(--ink);
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .cap-wip {
        font-size: 0.65rem;
        font-weight: 750;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #92400e;
        background: #fef3c7;
        border: 1px solid #fde68a;
        border-radius: 999px;
        padding: 0.05rem 0.5rem;
      }
      .cap-detail { color: var(--muted); font-size: 0.85rem; }

      /* ---------- COMMAND TEASER ---------- */
      .cmd-teaser a {
        color: var(--teal-darker);
        font-weight: 600;
        white-space: nowrap;
      }

      /* ---------- TERMINAL ---------- */
      .terminal {
        max-width: 720px;
        margin: 0 auto;
        background: #0b1220;
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: 0 24px 60px -28px rgba(15, 23, 42, 0.55);
        border: 1px solid #1e293b;
        text-align: left;
      }
      .terminal-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 0.9rem;
        background: #111a2e;
        border-bottom: 1px solid #1e293b;
      }
      .dot { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
      .dot-r { background: #ff5f56; }
      .dot-y { background: #ffbd2e; }
      .dot-g { background: #27c93f; }
      .terminal-title {
        margin-left: 0.6rem;
        color: #64748b;
        font-size: 0.78rem;
        font-family: var(--mono);
      }
      .terminal-body {
        margin: 0;
        padding: 1.25rem;
        overflow-x: auto;
        color: #e2e8f0;
        font-family: var(--mono);
        font-size: clamp(0.78rem, 2.2vw, 0.92rem);
        line-height: 1.7;
        text-align: left;
      }
      .terminal-body code { background: none; color: inherit; padding: 0; }
      .terminal-body .c { color: #64748b; }
      .terminal-body .p { color: #2dd4bf; }
      .terminal-body .ok { color: #4ade80; font-weight: 600; }
      .terminal-body .fail { color: #fb923c; font-weight: 600; }

      /* ---------- FOOTER ---------- */
      .footer {
        background: var(--ink);
        color: #cbd5e1;
        padding: 2.5rem 0 1.75rem;
      }
      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        color: #fff;
      }
      .footer-links {
        display: flex;
        gap: clamp(0.75rem, 3vw, 1.5rem);
        flex-wrap: wrap;
      }
      .footer-links a { color: #cbd5e1; font-size: 0.92rem; }
      .footer-links a:hover { color: #5eead4; }
      .footer-copy {
        max-width: var(--maxw);
        margin: 1.75rem auto 0;
        padding: 1.25rem clamp(1rem, 4vw, 2rem) 0;
        border-top: 1px solid #1e293b;
        color: #64748b;
        font-size: 0.82rem;
        text-align: center;
      }

      /* ---------- RESPONSIVE ---------- */
      @media (max-width: 640px) {
        .nav-inner { justify-content: center; }
        .footer-inner { justify-content: center; text-align: center; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { scroll-behavior: auto; transition: none !important; }
      }
    </style>
  </body>
</html>
