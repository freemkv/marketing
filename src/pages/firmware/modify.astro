---
// "Modify" — /firmware/modify/. freemkv-fw: turns a base image into freemkv
// firmware (`create`) and checks whether a file or a live drive is freemkv
// (`verify`). Carries the download link for the freemkv-fw binary, reusing
// the release-asset button pattern from src/pages/download.astro.
import FirmwareNavDropdown from '../../components/FirmwareNavDropdown.astro';

const title = 'freemkv-fw — modify firmware for freemkv';
const description =
  'freemkv-fw turns a MediaTek optical-drive firmware image into freemkv firmware, and verifies a file or a live drive.';

const docs = '/docs/overview/';
const github = 'https://github.com/freemkv';
const firmwareRepo = 'https://github.com/freemkv/freemkv-firmware';
const firmwareReleases = `${firmwareRepo}/releases`;

// Prebuilt binaries, grouped by OS into columns (matching the Download page).
// Asset names MUST match what the freemkv-firmware release workflow attaches
// (release.yml): `freemkv-<tool>-<os>-<arch>.<ext>` — tar.gz on Linux/macOS,
// zip on Windows.
const platforms = [
  {
    name: 'Windows',
    os: 'windows',
    builds: [
      { arch: 'x86_64', label: 'Intel / AMD 64-bit', slug: 'windows-x86_64', ext: 'zip' },
    ],
  },
  {
    name: 'macOS',
    os: 'macos',
    builds: [
      { arch: 'ARM64', label: 'Apple Silicon', slug: 'macos-arm64', ext: 'tar.gz' },
      { arch: 'x86_64', label: 'Intel', slug: 'macos-x86_64', ext: 'tar.gz' },
    ],
  },
  {
    name: 'Linux',
    os: 'linux',
    builds: [
      { arch: 'x86_64', label: 'Intel / AMD 64-bit', slug: 'linux-x86_64', ext: 'tar.gz' },
    ],
  },
];

const assetFor = (tool, b) => `freemkv-${tool}-${b.slug}.${b.ext}`;

// Capabilities freemkv-fw adds in one pass. These map 1:1 to the CDB command
// table in the firmware command reference — keep names, wording, and statuses
// in sync with src/content/docs/docs/firmware-tools.md.
const fwCapabilities = [
  { name: 'Identity', detail: 'Answers the "are you freemkv?" ping', status: 'ready' },
  { name: 'Speed', detail: 'Settable read-speed ceiling — lifts the riplock cap for full-rate ripping', status: 'ready' },
  { name: 'Volume ID (VID)', detail: 'Returns the disc AACS Volume ID in plaintext in the command response', status: 'ready' },
  { name: 'Bus Encryption', detail: 'Removes AACS in-transit (bus) encryption so read data comes back in the clear', status: 'ready' },
  { name: 'Region-free', detail: 'Every DVD reads as region-free (DVD-only)', status: 'ready' },
  { name: 'Diagnostic Dump', detail: '64-byte firmware RAM windows', status: 'ready' },
];
---

