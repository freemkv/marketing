        max-width: 640px;
        margin: 1.5rem auto 0;
        text-align: center;
        color: var(--muted);
        font-size: 0.92rem;
      }

      /* ---------- DOWNLOAD CARDS ---------- */
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
