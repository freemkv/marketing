        max-width: 760px;
        margin: 0 auto;
        padding: 0 clamp(1rem, 4vw, 2rem);
        text-align: center;
      }
      .hero-title {
        font-size: clamp(2rem, 7vw, 3rem);
        line-height: 1.08;
