        align-items: center;
        gap: 0.55rem;
        font-weight: 750;
        font-size: 1.15rem;
        color: var(--ink);
        letter-spacing: -0.01em;
      }
      .brand img { display: block; }
      .nav-links {
        display: flex;
        gap: clamp(0.75rem, 3vw, 1.75rem);
        align-items: center;
        flex-wrap: wrap;
      }
      .nav-links a {
        color: var(--slate);
        font-weight: 550;
        font-size: 0.95rem;
      }
      .nav-links a:hover { color: var(--teal-dark); }
      .nav-links a[aria-current="page"] { color: var(--teal-dark); font-weight: 650; }
      .nav-links a.gh-stars {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        font-variant-numeric: tabular-nums;
      }
