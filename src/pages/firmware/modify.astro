---
// "Modify" — /firmware/modify/. freemkv-fw: turns a base image into freemkv
// firmware (`create`) and checks whether a file or a live drive is freemkv
// (`verify`). Carries the download link for the freemkv-fw binary, reusing
// the release-asset button pattern from src/pages/download.astro.
import FirmwareNavDropdown from '../../components/FirmwareNavDropdown.astro';

const title = 'freemkv-fw — modify firmware for freemkv';
const description =
  'freemkv-fw turns a MediaTek optical-drive firmware image into freemkv firmware, and verifies a file or a live drive.';

const docs = '/docs/overview/';
const github = 'https://github.com/freemkv';
const firmwareRepo = 'https://github.com/freemkv/freemkv-firmware';
const firmwareReleases = `${firmwareRepo}/releases`;

// Prebuilt binaries, grouped by OS into columns (matching the Download page).
// Asset names MUST match what the freemkv-firmware release workflow attaches
// (release.yml): `freemkv-<tool>-<os>-<arch>.<ext>` — tar.gz on Linux/macOS,
// zip on Windows.
// GUI distribution per platform, matching the rest of freemkv:
//   windows -> direct download of the (unsigned) .exe zip
//   macos   -> Homebrew cask (ad-hoc signed .app in a .dmg; the cask strips
//              quarantine) — a browser download would be Gatekeeper-blocked
//   linux   -> no GUI at all (we only ship a Linux CLI, like every freemkv app)
// The CLI is a direct download on all three.
// One cask ships BOTH firmware GUIs (freemkv-flash-gui + freemkv-fw-gui) — they
// live in the same repo and are versioned together.
const guiCask = 'freemkv-firmware';
const platforms = [
  {
    name: 'Windows',
    os: 'windows',
    gui: 'download',
    builds: [
      { arch: 'x86_64', label: 'Intel / AMD 64-bit', slug: 'windows-x86_64', ext: 'zip' },
    ],
  },
  {
    name: 'macOS',
    os: 'macos',
    gui: 'brew',
    builds: [
      { arch: 'ARM64', label: 'Apple Silicon', slug: 'macos-arm64', ext: 'tar.gz' },
      { arch: 'x86_64', label: 'Intel', slug: 'macos-x86_64', ext: 'tar.gz' },
    ],
  },
  {
    name: 'Linux',
    os: 'linux',
    gui: false,
    builds: [
      { arch: 'x86_64', label: 'Intel / AMD 64-bit', slug: 'linux-x86_64', ext: 'tar.gz' },
    ],
  },
];

const assetFor = (tool, b) => `freemkv-${tool}-${b.slug}.${b.ext}`;

// Capabilities freemkv-fw adds in one pass. These map 1:1 to the CDB command
// table in the firmware command reference — keep names, wording, and statuses
// in sync with src/content/docs/docs/firmware-tools.md.
const fwCapabilities = [
  { name: 'Identity', detail: 'Answers the "are you freemkv?" ping', status: 'ready' },
  { name: 'Speed', detail: 'Settable read-speed ceiling — lifts the riplock cap for full-rate ripping', status: 'ready' },
  { name: 'Region-free', detail: 'Every DVD reads as region-free (DVD-only)', status: 'ready' },
  { name: 'Raw Read', detail: 'Drops the AACS drive↔host auth so the drive releases the Volume ID and returns sectors unencrypted on the bus — the host applies the title keys', status: 'ready' },
  { name: 'Diagnostic Dump', detail: '64-byte firmware RAM windows', status: 'ready' },
  { name: 'Downgrade Enable', detail: 'Sets the downgrade-enable (DE) byte, so freemkv installs over any existing firmware, OEM or 3rd party.', status: 'ready' },
  { name: 'Stays Stock', detail: 'The drive stays 100% stock until freemkv commands are enabled, and can be disabled again on the fly.', status: 'ready' },
];
import '../../styles/site.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://freemkv.org/firmware/modify/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://freemkv.org/freemkv-icon.svg" />
    <meta property="og:url" content="https://freemkv.org/firmware/modify/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://freemkv.org/freemkv-icon.svg" />
  </head>
  <body class="page-modify">
    <!-- ============ STICKY NAV ============ -->
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">
          <img src="/freemkv-icon.svg" alt="" width="32" height="32" />
          <span>freemkv</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={docs}>Docs</a>
          <a href="/download/">Software</a>
          <FirmwareNavDropdown active="modify" />
          <a
            class="nav-discord"
            href="https://discord.gg/yu7xMGTyek"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
          >
            <svg class="nav-discord-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.956-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.956 2.42-2.157 2.42zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.946 2.42-2.157 2.42z"/></svg>
          </a>
          <a
            class="gh-stars"
            href="https://github.com/freemkv/freemkv"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub stars"
            data-gh-repo="freemkv/freemkv"
          >
            <span class="gh-stars-num"><span data-gh-stars hidden></span>★</span>
            <svg class="gh-stars-logo" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero-inner">
          <h1 class="hero-title">freemkv-fw</h1>
          <div class="hero-badge">
            <span class="hero-badge-dot" aria-hidden="true"></span>
            <span>Beta</span>
          </div>
          <p class="hero-lead">
            <strong>freemkv-fw</strong> turns any stock MediaTek image into
            freemkv firmware, re-signed so the drive accepts it.
          </p>
        </div>
      </section>

      <!-- ============ CREATE ============ -->
      <section class="block">
        <div class="section-inner">
          <span class="kicker">Create</span>
          <h2 class="section-title">freemkv-fw create</h2>

          <div class="terminal">
            <div class="terminal-bar" aria-hidden="true">
              <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
              <span class="terminal-title">freemkv-fw create</span>
            </div>
            <pre class="terminal-body"><code><span class="c"># One input, one output — freemkv-fw auto-detects the model</span>
<span class="p">$</span> freemkv-fw create BU40N_1.00.bin BU40N_1.00.freemkv.bin

<span class="c">freemkv-fw 0.4.0 — detected LG BU40N · base 1.00</span>

  Identity ................. <span class="ok">added</span>
  Speed .................... <span class="ok">added</span>
  Region-free .............. <span class="ok">added</span>
  Raw Read ................. <span class="ok">added</span>
  Diagnostic Dump .......... <span class="ok">added</span>

<span class="c">Downgrade-enable (DE) byte ... set (flashes over any version)</span>
<span class="c">Re-signing integrity table ... ok</span>
<span class="c">Wrote BU40N_1.00.freemkv.bin (2,097,152 bytes)</span></code></pre>
          </div>

          <div class="grid cap-grid">
            {fwCapabilities.map((c) => (
              <div class="cap-item" data-status={c.status}>
                <span class={`cap-dot cap-dot-${c.status}`} aria-hidden="true"></span>
                <div class="cap-body">
                  <span class="cap-name">
                    {c.name}
                    {c.status === 'wip' && <span class="cap-wip">WIP</span>}
                  </span>
                  <span class="cap-detail">{c.detail}</span>
                </div>
              </div>
            ))}
          </div>


          <div class="grid dl-grid">
            {platforms.map((p) => (
              <article class="card" data-os={p.os}>
                <h3 class="card-title">{p.name}</h3>
                <div class="dl-list">
                  {p.builds.map((b) => (
                    <>
                      <a
                        class="btn btn-primary dl-btn"
                        href={`${firmwareRepo}/releases/latest/download/${assetFor('fw', b)}`}
                        download
                      >
                        <span class="dl-main">Download <span class="dl-arch">{b.arch}</span> · CLI</span>
                        <span class="dl-sub">{b.label} — terminal</span>
                      </a>
                      {p.gui === 'download' && (
                        <a
                          class="btn btn-primary dl-btn"
                          href={`${firmwareRepo}/releases/latest/download/${assetFor('fw-gui', b)}`}
                          download
                        >
                          <span class="dl-main">Download <span class="dl-arch">{b.arch}</span> · GUI</span>
                          <span class="dl-sub">{b.label} — app</span>
                        </a>
                      )}
                    </>
                  ))}
                  {p.gui === 'brew' && (
                    <p class="dl-brew-see">GUI app — install with Homebrew — see below ↓</p>
                  )}
                </div>
              </article>
            ))}
          </div>
          <p class="dl-note dl-brew">
            <strong>macOS — easiest:</strong> Homebrew installs the GUI app (flash + modify) and
            skips the security prompt entirely.
            <code class="dl-cmd">brew install --cask freemkv/tap/{guiCask}</code>
          </p>
          <p class="dl-note">
            <a href={firmwareReleases}>All releases on GitHub →</a>
            <a href={firmwareRepo}>View on GitHub →</a>
          </p>

          <div class="next-step">
            <a class="next-step-link" href="/firmware/flash/">
              Next: flash it <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="section-inner footer-inner">
        <div class="footer-brand">
          <img src="/freemkv-icon.svg" alt="" width="28" height="28" />
          <span>freemkv</span>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={github}>GitHub</a>
          <a href="https://github.com/freemkv/freemkv/blob/main/LICENSE">License (MIT)</a>
        </nav>
      </div>
      <p class="footer-copy">MIT · Recover 100% of readable data from any optical disc.</p>
    </footer>

    <script is:inline>
      (function () {
        var el = document.querySelector('a.gh-stars');
        if (!el) return;
        var repo = el.dataset.ghRepo;
        var countEl = el.querySelector('[data-gh-stars]');
        if (!repo || !countEl) return;
        var CACHE_KEY = 'freemkv:gh-stars:' + repo;
        var TTL_MS = 60 * 60 * 1000;
        function format(n) {
          if (!isFinite(n) || n < 0) return '';
          if (n < 1000) return String(n);
          var k = n / 1000;
          var s = k < 10 ? k.toFixed(1) : Math.round(k).toString();
          return s.replace(/\.0$/, '') + 'k';
        }
        function show(n) {
          var text = format(n);
          if (!text) return;
          countEl.textContent = text;
          countEl.hidden = false;
          el.setAttribute('aria-label', 'GitHub stars: ' + n.toLocaleString());
        }
        try {
          var raw = localStorage.getItem(CACHE_KEY);
          if (raw) {
            var cached = JSON.parse(raw);
            if (cached && typeof cached.count === 'number') {
              show(cached.count);
              if (Date.now() - cached.ts < TTL_MS) return;
            }
          }
        } catch (e) {}
        fetch('https://api.github.com/repos/' + repo, {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
          .then(function (data) {
            var count = data && data.stargazers_count;
            if (typeof count !== 'number') return;
            show(count);
            try { localStorage.setItem(CACHE_KEY, JSON.stringify({ count: count, ts: Date.now() })); } catch (e) {}
          })
          .catch(function () {});
      })();
    </script>

  </body>
</html>
