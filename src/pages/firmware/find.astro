---
// "Find your drive" — /firmware/find/.
// Typeable search over the drive index in src/data/firmware-index.json using a
// compact custom combobox (capped, scrollable, field-width list — no native
// datalist balloon). Search matches on MODEL NAME only; brand and chip are
// never shown in the picker. Selecting a model reveals a versions dropdown,
// then a short detail card with either a download button (for a hosted base)
// or a disabled "Unavailable" button plus a "donate it on Discord" call to
// action (for a base we don't host yet — crowdsources the missing firmware).
import FirmwareNavDropdown from '../../components/FirmwareNavDropdown.astro';
import firmwareIndex from '../../data/firmware-index.json';

const title = 'Find your drive firmware — freemkv';
const description =
  'Search your optical drive model to find its firmware base image for freemkv.';

const docs = '/docs/overview/';
const github = 'https://github.com/freemkv';
const firmwareRepo = 'https://github.com/freemkv/freemkv-firmware';
const firmwareBaseUrl = `${firmwareRepo}/releases/latest/download`;

// Only LG BU40N rev 1.00 has a real hosted release asset today. Every other
// model/revision shows the "ask on Discord" line instead of a dead link.
const HOSTED = new Set(['BU40N:1.00']);
const hostedList = [...HOSTED];
import '../../styles/site.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://freemkv.org/firmware/find/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://freemkv.org/freemkv-icon.svg" />
    <meta property="og:url" content="https://freemkv.org/firmware/find/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://freemkv.org/freemkv-icon.svg" />
  </head>
  <body class="page-find">
    <!-- ============ STICKY NAV ============ -->
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">
          <img src="/freemkv-icon.svg" alt="" width="32" height="32" />
          <span>freemkv</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={docs}>Docs</a>
          <a href="/download/">Software</a>
          <FirmwareNavDropdown active="find" />
          <a
            class="nav-discord"
            href="https://discord.gg/yu7xMGTyek"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
          >
            <svg class="nav-discord-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.956-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.956 2.42-2.157 2.42zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.946 2.42-2.157 2.42z"/></svg>
          </a>
          <a
            class="gh-stars"
            href="https://github.com/freemkv/freemkv"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub stars"
            data-gh-repo="freemkv/freemkv"
          >
            <span class="gh-stars-num"><span data-gh-stars hidden></span>★</span>
            <svg class="gh-stars-logo" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero-inner">
          <h1 class="hero-title">Find your drive</h1>
          <p class="hero-lead">
            Type your drive's model number to find its firmware base image.
          </p>
        </div>
      </section>

      <!-- ============ SEARCH ============ -->
      <section class="block">
        <div class="section-inner">
          <div class="picker">
            <div class="picker-row">
              <label class="picker-label" for="drive-search">Drive model</label>
              <div class="combo" data-combo>
                <input
                  class="picker-input"
                  id="drive-search"
                  type="text"
                  role="combobox"
                  aria-expanded="false"
                  aria-controls="drive-options"
                  aria-autocomplete="list"
                  placeholder="e.g. BU40N"
                  autocomplete="off"
                  spellcheck="false"
                />
                <ul class="picker-options" id="drive-options" role="listbox" aria-label="Drive models" hidden></ul>
              </div>
            </div>
            <div class="picker-row" id="rev-row" hidden>
              <label class="picker-label" for="drive-rev">Firmware revision</label>
              <select class="picker-select" id="drive-rev" aria-label="Select firmware revision"></select>
            </div>
          </div>

          <div class="picker-detail" id="drive-detail"></div>

          <p class="block-note">
            Don't see your drive listed, or want to help us add one? Drop by
            <a href="https://discord.gg/yu7xMGTyek">Discord</a>.
          </p>

          <div class="next-step">
            <a class="next-step-link" href="/firmware/modify/">
              Next: modify it <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <script define:vars={{ firmwareIndex, hostedList, firmwareBaseUrl }}>
        (function () {
          var searchInput = document.getElementById('drive-search');
          var optionsList = document.getElementById('drive-options');
          var revRow = document.getElementById('rev-row');
          var revSel = document.getElementById('drive-rev');
          var detail = document.getElementById('drive-detail');
          if (!searchInput || !optionsList || !revSel || !detail) return;

          var hosted = {};
          hostedList.forEach(function (k) { hosted[k] = true; });

          var filtered = [];
          var activeIdx = -1;

          // Number of hosted (downloadable) revisions for a model — the
          // basis for the Available/Unavailable split in the picker list.
          function hostedCount(d) {
            var n = 0;
            d.versions.forEach(function (v) {
              if (hosted[d.model + ':' + v.rev]) n++;
            });
            return n;
          }

          function findModel(name) {
            var needle = (name || '').trim().toLowerCase();
            if (!needle) return null;
            return firmwareIndex.find(function (d) { return d.model.toLowerCase() === needle; }) || null;
          }

          // Substring match on MODEL NAME only — no brand, no chip.
          function filterModels(q) {
            var needle = (q || '').trim().toLowerCase();
            if (!needle) return firmwareIndex.slice();
            return firmwareIndex.filter(function (d) {
              return d.model.toLowerCase().indexOf(needle) !== -1;
            });
          }

          function closeList() {
            optionsList.hidden = true;
            searchInput.setAttribute('aria-expanded', 'false');
            activeIdx = -1;
          }

          function addGroupLabel(text) {
            var li = document.createElement('li');
            li.className = 'picker-group-label';
            li.setAttribute('role', 'presentation');
            li.textContent = text;
            optionsList.appendChild(li);
          }

          function addOption(d, count) {
            var li = document.createElement('li');
            li.className = 'picker-option' + (count > 0 ? '' : ' picker-option-unavailable');
            li.setAttribute('role', 'option');
            li.textContent = count > 0 ? d.model + ' (' + count + ')' : d.model;
            li.addEventListener('mousedown', function (e) {
              e.preventDefault();
              choose(d);
            });
            optionsList.appendChild(li);
          }

          // Split the model list into an "Available" group (>=1 hosted
          // revision) shown first, and an "Unavailable" group (0 hosted
          // revisions) shown after — so a model with no firmware files is
          // obvious before it's ever selected.
          function openList(list) {
            optionsList.innerHTML = '';
            if (!list.length) {
              filtered = [];
              var empty = document.createElement('li');
              empty.className = 'picker-empty';
              empty.textContent = 'No matching drive models';
              optionsList.appendChild(empty);
            } else {
              var available = [];
              var unavailable = [];
              list.forEach(function (d) {
                var n = hostedCount(d);
                (n > 0 ? available : unavailable).push({ d: d, n: n });
              });
              filtered = available.concat(unavailable).map(function (e) { return e.d; });

              if (available.length) {
                addGroupLabel('Available');
                available.forEach(function (e) { addOption(e.d, e.n); });
              }
              if (unavailable.length) {
                addGroupLabel('Unavailable');
                unavailable.forEach(function (e) { addOption(e.d, e.n); });
              }
            }
            optionsList.hidden = false;
            searchInput.setAttribute('aria-expanded', 'true');
            activeIdx = -1;
          }

          function setActive(idx) {
            var opts = optionsList.querySelectorAll('.picker-option');
            if (!opts.length) return;
            if (idx < 0) idx = opts.length - 1;
            if (idx >= opts.length) idx = 0;
            for (var i = 0; i < opts.length; i++) opts[i].classList.remove('is-active');
            opts[idx].classList.add('is-active');
            opts[idx].scrollIntoView({ block: 'nearest' });
            activeIdx = idx;
          }

          function choose(d) {
            searchInput.value = d.model;
            closeList();
            populateRevs(d);
            render();
          }

          function populateRevs(d) {
            revSel.innerHTML = '';
            d.versions.forEach(function (v, i) {
              var opt = document.createElement('option');
              opt.value = String(i);
              opt.textContent = v.rev;
              revSel.appendChild(opt);
            });
          }

          function render() {
            var d = findModel(searchInput.value);
            if (!d) {
              revRow.hidden = true;
              detail.innerHTML = '';
              detail.hidden = true;
              return;
            }
            revRow.hidden = false;
            detail.hidden = false;

            var v = d.versions[Number(revSel.value) || 0];
            var key = d.model + ':' + v.rev;
            var isHosted = !!hosted[key];

            var bodyHtml;
            if (isHosted) {
              bodyHtml =
                '<a class="btn btn-primary dl-btn drive-fw-btn" href="' + firmwareBaseUrl + '/' + v.file + '" download>' +
                '<span class="dl-main">Download <span class="dl-arch">' + v.file + '</span></span>' +
                '</a>' +
                '<div class="drive-fw-hint">' +
                '<span class="drive-fw-hint-label">Then build it:</span>' +
                '<code class="drive-fw-cmd">freemkv-fw create ' + v.file + ' my-drive.freemkv.bin</code>' +
                '</div>';
            } else {
              bodyHtml =
                '<span class="btn drive-fw-btn drive-fw-btn-disabled" aria-disabled="true">Unavailable</span>' +
                '<p class="drive-fw-hint drive-fw-note">Have this firmware? ' +
                '<a class="drive-fw-link" href="https://discord.gg/yu7xMGTyek">Donate it on Discord →</a></p>';
            }

            detail.innerHTML =
              '<div class="drive-detail-head">' +
              '<h3 class="card-title drive-title">' + d.brand + ' ' + d.model + '</h3>' +
              '<span class="drive-rev">rev ' + v.rev + '</span>' +
              '</div>' +
              bodyHtml;
          }

          searchInput.addEventListener('input', function () {
            openList(filterModels(searchInput.value));
            var d = findModel(searchInput.value);
            if (d) {
              populateRevs(d);
              render();
            } else {
              revRow.hidden = true;
              detail.hidden = true;
              detail.innerHTML = '';
            }
          });
          searchInput.addEventListener('focus', function () {
            if (optionsList.hidden) openList(filterModels(searchInput.value));
          });
          searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              if (optionsList.hidden) openList(filterModels(searchInput.value));
              setActive(activeIdx + 1);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              setActive(activeIdx - 1);
            } else if (e.key === 'Enter') {
              if (!optionsList.hidden && activeIdx >= 0 && filtered[activeIdx]) {
                e.preventDefault();
                choose(filtered[activeIdx]);
              }
            } else if (e.key === 'Escape') {
              closeList();
            }
          });
          document.addEventListener('click', function (e) {
            if (!e.target.closest('[data-combo]')) closeList();
          });
          revSel.addEventListener('change', render);

          detail.hidden = true;
          revRow.hidden = true;
        })();
      </script>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="section-inner footer-inner">
        <div class="footer-brand">
          <img src="/freemkv-icon.svg" alt="" width="28" height="28" />
          <span>freemkv</span>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={github}>GitHub</a>
          <a href="https://github.com/freemkv/freemkv/blob/main/LICENSE">License (MIT)</a>
        </nav>
      </div>
      <p class="footer-copy">MIT · Recover 100% of readable data from any optical disc.</p>
    </footer>

    <script is:inline>
      (function () {
        var el = document.querySelector('a.gh-stars');
        if (!el) return;
        var repo = el.dataset.ghRepo;
        var countEl = el.querySelector('[data-gh-stars]');
        if (!repo || !countEl) return;
        var CACHE_KEY = 'freemkv:gh-stars:' + repo;
        var TTL_MS = 60 * 60 * 1000;
        function format(n) {
          if (!isFinite(n) || n < 0) return '';
          if (n < 1000) return String(n);
          var k = n / 1000;
          var s = k < 10 ? k.toFixed(1) : Math.round(k).toString();
          return s.replace(/\.0$/, '') + 'k';
        }
        function show(n) {
          var text = format(n);
          if (!text) return;
          countEl.textContent = text;
          countEl.hidden = false;
          el.setAttribute('aria-label', 'GitHub stars: ' + n.toLocaleString());
        }
        try {
          var raw = localStorage.getItem(CACHE_KEY);
          if (raw) {
            var cached = JSON.parse(raw);
            if (cached && typeof cached.count === 'number') {
              show(cached.count);
              if (Date.now() - cached.ts < TTL_MS) return;
            }
          }
        } catch (e) {}
        fetch('https://api.github.com/repos/' + repo, {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
          .then(function (data) {
            var count = data && data.stargazers_count;
            if (typeof count !== 'number') return;
            show(count);
            try { localStorage.setItem(CACHE_KEY, JSON.stringify({ count: count, ts: Date.now() })); } catch (e) {}
          })
          .catch(function () {});
      })();
    </script>

  </body>
</html>
