---
import { graph, websiteNode, orgNode, webPageNode, breadcrumbNode } from '../../lib/jsonld.mjs';
// "Find your drive" — /firmware/find/.
// Type a drive model, pick a firmware revision, get a short card with the
// download, its versions and what else the same hardware can be flashed to.
// Data: src/data/finder-catalog.json (+ crossflash-links.json from
// freemkv-flash's `freemkv-crossflash`), shaped by finderPageData() in
// src/lib/finder.mjs at build time. The old site indexes only add MediaTek
// feature data and keep their model names listed.
import FirmwareNavDropdown from '../../components/FirmwareNavDropdown.astro';
import mediatekIndex from '../../data/firmware-index.json';
import pioneerIndex from '../../data/pioneer-firmware-index.json';
import finderCatalog from '../../data/finder-catalog.json';
import crossflashLinks from '../../data/crossflash-links.json';
import { buildFinderData, finderPageData, modelVersionSummary } from '../../lib/finder.mjs';

const title = 'Find your drive firmware — freemkv';
const description =
  'Search your optical drive model to find its firmware base image for freemkv.';

const docs = '/docs/overview/';
const github = 'https://github.com/freemkv';
// Protected builds (Turnstile site key set) download through /api/firmware-download
// and must not ship the public bucket origin at all.
const firmwareDownloadSitekey = import.meta.env.PUBLIC_FIRMWARE_TURNSTILE_SITEKEY || '';
const protectedDownloads = Boolean(firmwareDownloadSitekey);
const firmwareBaseUrl = protectedDownloads ? '' : 'https://pub-10fe57a98db44568abcfb5db130d3b3f.r2.dev';

const finderData = buildFinderData({ catalog: finderCatalog, mediatek: mediatekIndex, crossflash: crossflashLinks });
const finder = finderPageData(finderData, { legacy: [...mediatekIndex, ...pioneerIndex], keys: !protectedDownloads });
const { total: hostedTotal, byChip: hostedByChip } = modelVersionSummary(finder);
import '../../styles/site.css';
---


<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://freemkv.org/firmware/find/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://freemkv.org/freemkv-icon.svg" />
    <meta property="og:url" content="https://freemkv.org/firmware/find/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://freemkv.org/freemkv-icon.svg" />
    <script type="application/ld+json" set:html={graph(webPageNode({ path: '/firmware/find/', name: title, description }), breadcrumbNode('/firmware/find/', [['freemkv', '/'], ['Firmware', '/firmware/'], ['Find', '/firmware/find/']]), websiteNode(), orgNode())} />
    <style is:global>
      #drive-detail { scroll-margin-top: 6rem; }
      .fx-view { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; }
      .fx-viewing { color: var(--muted); font-size: 0.9rem; }
      .fx-vgroup { margin: 0.9rem 0 0.2rem; font-size: 0.8rem; font-weight: 700; color: var(--slate); text-transform: uppercase; letter-spacing: 0.05em; }
      .fx-file { margin: 0.4rem 0 0; font-size: 0.8rem; color: var(--muted); overflow-wrap: anywhere; }
      .fx-h { margin: 1.3rem 0 0.4rem; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--teal-dark); }
      .fx-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; font-size: 0.92rem; }
      .fx-list li { display: flex; gap: 0.75rem; align-items: baseline; }
      .fx-rev-num { font-family: var(--mono); font-weight: 700; min-width: 3.5rem; }
      .fx-edition { font-family: var(--mono); color: var(--muted); min-width: 5rem; }
      .drive-aka { margin: 0.1rem 0 0.6rem; font-size: 0.85rem; color: var(--muted); }
      .fx-dl { font-size: 0.85rem; font-weight: 600; color: var(--teal-dark); }
      .fx-details { margin-top: 1rem; font-size: 0.82rem; }
      .fx-details summary { cursor: pointer; color: var(--slate); font-weight: 600; }
      .fx-table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; display: block; overflow-x: auto; }
      .fx-table th, .fx-table td { text-align: left; padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
      .fx-sha { font-size: 0.72rem; word-break: break-all; }
      .fx-note { margin: 0.4rem 0 0; font-size: 0.8rem; color: var(--muted); }
    </style>
  </head>
  <body class="page-find">
    <!-- ============ STICKY NAV ============ -->
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">
          <img src="/freemkv-icon.svg" alt="" width="32" height="32" />
          <span>freemkv</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={docs}>Docs</a>
          <a href="/download/">Software</a>
          <FirmwareNavDropdown active="find" />
          <a
            class="nav-discord"
            href="https://discord.gg/yu7xMGTyek"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
          >
            <svg class="nav-discord-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.956-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.956 2.42-2.157 2.42zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.946 2.42-2.157 2.42z"/></svg>
          </a>
          <a
            class="gh-stars"
            href="https://github.com/freemkv/freemkv"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub stars"
            data-gh-repo="freemkv/freemkv"
          >
            <span class="gh-stars-num"><span data-gh-stars hidden></span>★</span>
            <svg class="gh-stars-logo" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero-inner">
          <h1 class="hero-title">Find your drive</h1>
          <p class="hero-lead">
            Type your drive's model number to find its firmware.
          </p>
          <p class="hero-stat">
            <strong>{hostedTotal}</strong> OEM firmwares available
          </p>
          <div class="hero-stat-pills">
            {hostedByChip.map(([chip, n]) => (
              <span class="stat-pill"><strong>{n}</strong> {chip}</span>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ SEARCH ============ -->
      <section class="block">
        <div class="section-inner">
          <div class="picker">
            <div class="picker-row">
              <label class="picker-label" for="drive-search">Drive model</label>
              <div class="combo" data-combo>
                <input
                  class="picker-input"
                  id="drive-search"
                  type="text"
                  role="combobox"
                  aria-expanded="false"
                  aria-controls="drive-options"
                  aria-autocomplete="list"
                  placeholder="e.g. BU40N"
                  autocomplete="off"
                  spellcheck="false"
                />
                <ul class="picker-options" id="drive-options" role="listbox" aria-label="Drive models" hidden></ul>
              </div>
            </div>
            <div class="picker-row rev-row is-hidden" id="rev-row">
              <label class="picker-label" for="drive-rev">Firmware revision</label>
              <div class="combo" data-combo>
                <input
                  class="picker-input"
                  id="drive-rev"
                  type="text"
                  role="combobox"
                  aria-expanded="false"
                  aria-controls="rev-options"
                  aria-autocomplete="list"
                  placeholder="Select revision"
                  autocomplete="off"
                  spellcheck="false"
                  readonly
                />
                <ul class="picker-options" id="rev-options" role="listbox" aria-label="Firmware revisions" hidden></ul>
              </div>
            </div>
          </div>

          <div class="picker-detail" id="drive-detail"></div>

          <p class="block-note" id="modify-feature-note">
            Firmware features are structurally validated and self-verifying; the
            levers are structurally verified across the corpus.
          </p>

          <p class="block-note">
            Don't see your drive listed, or want to help us add one? Drop by <a href="https://discord.gg/yu7xMGTyek">Discord</a>.
          </p>

          <div class="next-step" id="modify-next-step" hidden>
            <a class="next-step-link" id="firmware-next-link" href="/firmware/flash/">
              Next: flash it <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      {protectedDownloads && <div id="firmware-download-config" data-sitekey={firmwareDownloadSitekey} hidden />}
      {protectedDownloads && <script is:inline type="module" src="/firmware-download.js"></script>}
      <script define:vars={{ finder, firmwareBaseUrl }}>
        (function () {
          var searchInput = document.getElementById('drive-search');
          var optionsList = document.getElementById('drive-options');
          var revRow = document.getElementById('rev-row');
          var revInput = document.getElementById('drive-rev');
          var revOptions = document.getElementById('rev-options');
          var detail = document.getElementById('drive-detail');
          if (!searchInput || !optionsList || !revInput || !revOptions || !detail) return;
          // Versions are picked from the card's list; the revision dropdown is gone.
          revRow.hidden = true;
          revRow.style.display = 'none';

          var models = finder.models, versions = finder.versions, identities = finder.identities, packages = finder.packages;

          var filtered = [];
          var activeIdx = -1;

          // Currently-selected model + revision index (the rev combobox mirrors
          // the model combobox, but its options are the chosen model's versions).
          var curModel = null;
          var curRevIdx = 0;
          var revActiveIdx = -1;

          function compact(text) {
            return String(text || '').toUpperCase().replace(/[^A-Z0-9]+/g, '');
          }

          function findModel(name) {
            var needle = compact(name);
            if (!needle) return null;
            return models.find(function (d) { return compact(d.m) === needle; }) || null;
          }

          // Pioneer edition next to a revision ("ID58", "GENERAL", an OEM).
          function editionHtml(id) {
            return id.pio && id.e ? '<span class="fx-edition">' + escapeText(id.e) + '</span>' : '';
          }

          // Editions sharing a revision: GENERAL, then IDs numerically, then OEMs.
          function editionOrder(a, b) {
            var rank = function (e) { return !e || e === 'GENERAL' ? 0 : /^ID\d+$/.test(e) ? 1 : 2; };
            return rank(a.e) - rank(b.e) || String(a.e).localeCompare(String(b.e), undefined, { numeric: true });
          }

          function escapeText(text) {
            return String(text).replace(/[&<>"']/g, function (c) {
              return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
          }

          function versionMatches(d, v, terms) {
            var text = d.t + ' ' + identities[versions[v[0]].i].t + ' ' + v[1].toLowerCase();
            return terms.every(function (term) { return text.indexOf(term) !== -1; });
          }

          function queryTerms(query) {
            return String(query || '').toLowerCase().replace(/[_-]+/g, ' ').trim().split(/\s+/).filter(Boolean);
          }

          function matchingVersionIndex(d, query) {
            // Newest matching revision; `d.o` is the row order newest first.
            var terms = queryTerms(query);
            var order = d.o || d.v.map(function (_, n) { return n; });
            for (var k = 0; k < order.length; k++) if (versionMatches(d, d.v[order[k]], terms)) return order[k];
            return order.length ? order[0] : 0;
          }

          function filterModels(q) {
            var terms = queryTerms(q);
            return models.filter(function (d) {
              return d.v.some(function (v) { return versionMatches(d, v, terms); });
            });
          }

          function closeList() {
            optionsList.hidden = true;
            searchInput.setAttribute('aria-expanded', 'false');
            activeIdx = -1;
          }

          function addOption(d) {
            var li = document.createElement('li');
            li.className = 'picker-option';
            li.setAttribute('role', 'option');
            li.textContent = d.m + ' (' + d.v.length + ')';
            li.addEventListener('mousedown', function (e) {
              e.preventDefault();
              choose(d);
            });
            optionsList.appendChild(li);
          }

          function openList(list) {
            optionsList.innerHTML = '';
            filtered = list;
            if (!list.length) {
              var empty = document.createElement('li');
              empty.className = 'picker-empty';
              empty.textContent = 'No matching drive models';
              optionsList.appendChild(empty);
            } else {
              list.forEach(addOption);
            }
            optionsList.hidden = false;
            searchInput.setAttribute('aria-expanded', 'true');
            activeIdx = -1;
          }

          function setActive(idx) {
            var opts = optionsList.querySelectorAll('.picker-option');
            if (!opts.length) return;
            if (idx < 0) idx = opts.length - 1;
            if (idx >= opts.length) idx = 0;
            for (var i = 0; i < opts.length; i++) opts[i].classList.remove('is-active');
            opts[idx].classList.add('is-active');
            opts[idx].scrollIntoView({ block: 'nearest' });
            activeIdx = idx;
          }

          function choose(d) {
            var query = searchInput.value;
            searchInput.value = d.m;
            closeList();
            selectModel(d, query);
          }

          // Reveal + populate the revision combobox for a model. Reserves its
          // space when hidden (.is-hidden) so revealing it never shifts the page.
          function selectModel(d, query, revIdx) {
            curModel = d;
            curRevIdx = revIdx != null ? revIdx : matchingVersionIndex(d, query);
            revInput.value = d.v[curRevIdx][1];
            closeRevList();
            render();
          }

          function resetSelection() {
            curModel = null;
            document.getElementById('modify-next-step').hidden = true;
            document.getElementById('modify-feature-note').hidden = true;
            revRow.classList.add('is-hidden');
            closeRevList();
            revInput.value = '';
            detail.hidden = true;
            detail.innerHTML = '';
          }

          function closeRevList() {
            revOptions.hidden = true;
            revInput.setAttribute('aria-expanded', 'false');
            revActiveIdx = -1;
          }

          function openRevList() {
            if (!curModel) return;
            revOptions.innerHTML = '';
            curModel.v.forEach(function (v, i) {
              var li = document.createElement('li');
              li.className = 'picker-option' + (i === curRevIdx ? ' is-active' : '');
              li.setAttribute('role', 'option');
              li.textContent = v[1];
              li.addEventListener('mousedown', function (ev) {
                ev.preventDefault();
                chooseRev(i);
              });
              revOptions.appendChild(li);
            });
            revOptions.hidden = false;
            revInput.setAttribute('aria-expanded', 'true');
            revActiveIdx = curRevIdx;
          }

          function setRevActive(idx) {
            var opts = revOptions.querySelectorAll('.picker-option');
            if (!opts.length) return;
            if (idx < 0) idx = opts.length - 1;
            if (idx >= opts.length) idx = 0;
            for (var i = 0; i < opts.length; i++) opts[i].classList.remove('is-active');
            opts[idx].classList.add('is-active');
            opts[idx].scrollIntoView({ block: 'nearest' });
            revActiveIdx = idx;
          }

          function chooseRev(i) {
            curRevIdx = i;
            revInput.value = curModel.v[i][1];
            closeRevList();
            render();
          }

          // Protected builds: Turnstile-gated POST via /firmware-download.js.
          // Public builds: a plain link to the object.
          function download(p, label, cls) {
            var attrs = firmwareBaseUrl
              ? 'href="' + escapeText(firmwareBaseUrl + '/' + p.k) + '" download="' + escapeText(p.f) + '"'
              : 'href="/firmware/find/" data-firmware-package="' + escapeText(p.s) + '" data-filename="' + escapeText(p.f) + '"';
            return '<a class="' + cls + '" ' + attrs + '>' + label + '</a>';
          }

          function render() {
            var d = curModel;
            if (!d) {
              detail.innerHTML = '';
              detail.hidden = true;
              return;
            }
            detail.hidden = false;

            var ver = versions[d.v[curRevIdx][0]];
            var ident = identities[ver.i];
            var p = packages[ver.p[0]];
            var canModify = ver.mod === 1;
            document.getElementById('modify-next-step').hidden = false;
            var nextLink = document.getElementById('firmware-next-link');
            nextLink.href = canModify ? '/firmware/modify/' : '/firmware/flash/';
            nextLink.textContent = canModify ? 'Next: modify it →' : 'Next: flash it →';
            document.getElementById('modify-feature-note').hidden = !canModify;

            var facts = p.chips.map(function (c) {
              return '<span class="drive-fact' + (c[1] ? ' ' + c[1] : '') + '"' + (c[2] ? ' title="' + escapeText(c[2]) + '"' : '') + '>' + escapeText(c[0]) + '</span>';
            }).join('');
            var factsHtml = facts ? '<div class="drive-facts">' + facts + '</div>' : '';

            var capsHtml = '';
            if (canModify && ver.baseOnly) {
              capsHtml =
                '<div class="drive-caps drive-caps-base">' +
                '<span class="drive-caps-label">Features</span>' +
                '<span class="drive-cap drive-cap-on">Identity</span>' +
                '<span class="drive-cap drive-cap-on">Save / Reset</span>' +
                '<span class="drive-cap-note">Base only — unlock flags pending hardware validation</span>' +
                '</div>';
            } else if (canModify && ver.features) {
              capsHtml = '<div class="drive-caps"><span class="drive-caps-label">Features</span>' +
                ver.features.map(function (f) {
                  return '<span class="drive-cap ' + (f.ok ? 'drive-cap-on' : 'drive-cap-off') + '">' + escapeText(f.name) + '</span>';
                }).join('') + '</div>';
            }

            var bodyHtml =
              download(p, '<span class="dl-main">Download ' + escapeText(ver.r) + '</span>', 'btn btn-primary dl-btn drive-fw-btn') +
              '<p class="fx-file">' + escapeText(p.f) + (p.b ? ' · ' + escapeText(p.b) : '') + '</p>' +
              (canModify
                ? '<div class="drive-fw-hint"><span class="drive-fw-hint-label">Then build it:</span>' +
                  '<code class="drive-fw-cmd">freemkv-fw create ' + escapeText(p.f) + ' my-drive.freemkv.bin</code></div>'
                : '') +
              '';

            var list = '';
            var rows = '';
            if (d.v.length > 1) {
              // Vertical list. Pioneer: one heading per SAT in ascending order (the viewed one
              // marked when there are several), the edition (GENERAL, ID58, an OEM) next to each revision. Others: brand headings, maker
              // first, then OEMs, unknown editions last. Newest first in each group.
              var groups = [], byName = {};
              d.v.forEach(function (row, n) {
                var id = identities[versions[row[0]].i];
                var g = id.h || id.g || 'Other editions';
                if (!byName[g]) { byName[g] = []; groups.push(g); }
                byName[g].push(n);
              });
              var isSat = function (g) { return d.v.some(function (row) { return identities[versions[row[0]].i].h === g; }); };
              var rank = function (g) { return isSat(g) ? -1 : g === 'Other editions' ? 2 : (g === ident.brand && !ident.d) || g === 'LG' || g === 'Pioneer' ? 0 : 1; };
              groups.sort(function (a, b) { return rank(a) - rank(b) || a.localeCompare(b); });
              var revKey = function (r) { return /^\d+\.\d+/.test(r) ? '1' + r : '0' + r; };
              list = '<h4 class="fx-h">Versions</h4>' + groups.map(function (g) {
                var rows = byName[g].slice().sort(function (a, b) {
                  var ra = revKey(versions[d.v[a][0]].r), rb = revKey(versions[d.v[b][0]].r);
                  return ra < rb ? 1 : ra > rb ? -1 : editionOrder(identities[versions[d.v[a][0]].i], identities[versions[d.v[b][0]].i]);
                });
                var viewing = g === ident.h && groups.filter(isSat).length > 1 ? ' · viewing' : '';
                return '<p class="fx-vgroup">' + escapeText(g + viewing) + '</p><ul class="fx-list">' + rows.map(function (n) {
                  var id = identities[versions[d.v[n][0]].i];
                  return '<li><span class="fx-rev-num">' + escapeText(versions[d.v[n][0]].r) + '</span>' + editionHtml(id) +
                    (n === curRevIdx ? '<span class="fx-viewing">Viewing</span>'
                      : '<button type="button" class="fx-dl fx-view" data-view="' + n + '">View</button>') + '</li>';
                }).join('') + '</ul>';
              }).join('');
            }
            ident.v.forEach(function (vi) {
              var v = versions[vi];
              v.p.forEach(function (pi, n) {
                var q = packages[pi];
                rows += '<tr><td>' + escapeText(v.r) + '</td><td>' + escapeText(q.f) + (q.b ? ' (' + escapeText(q.b) + ')' : '') +
                  (n > 0 ? '<br>' + download(q, 'Download', 'fx-dl') : '') + '</td><td>' + escapeText(q.contents) +
                  (q.built ? '<br>Built ' + escapeText(q.built) : '') +
                  '</td><td><code class="fx-sha">' + escapeText(q.s) + '</code></td></tr>';
              });
            });
            var details = '<details class="fx-details"><summary>Details</summary><table class="fx-table"><thead><tr>' +
              '<th scope="col">Revision</th><th scope="col">File</th><th scope="col">Contents</th><th scope="col">SHA-256</th>' +
              '</tr></thead><tbody>' + rows + '</tbody></table></details>';

            // Cross Flash: every target shares this edition's hardware family, whatever its SAT,
            // so there is no SAT heading. A revision without a Kernel is listed, not viewable.
            var xf = '';
            // This model's own editions are already under Versions; leave them out here.
            var own = {};
            d.v.forEach(function (row) { own[versions[row[0]].i] = 1; });
            var targets = ident.x.map(function (x) {
              return [x[0], x[1], x[2].filter(function (row) { return !own[row[0]]; })];
            }).filter(function (x) { return x[2].length; });
            if (targets.length) {
              xf = '<h4 class="fx-h">Cross Flash</h4>' + targets.map(function (x) {
                return '<p class="fx-vgroup">' + escapeText(x[0]) + (x[1] ? ' (UHD)' : '') + '</p><ul class="fx-list">' +
                  x[2].map(function (row) {
                    return '<li><span class="fx-rev-num">' + escapeText(versions[row[1]].r) + '</span>' + editionHtml(identities[row[0]]) +
                      (row[2] ? '<span class="fx-viewing">Incomplete - missing kernel</span>'
                        : '<button type="button" class="fx-dl fx-view" data-xf="' + row[0] + '" data-xv="' + row[1] + '">View</button>') + '</li>';
                  }).join('') + '</ul>';
              }).join('');
            }

            var name = ident.brand && compact(d.m).indexOf(compact(ident.brand)) !== 0 ? ident.brand + ' ' + d.m : d.m;
            detail.innerHTML =
              '<div class="drive-detail-head">' +
              '<h3 class="card-title drive-title">' + escapeText(name) + '</h3>' +
              '<span class="drive-rev">rev ' + escapeText(ver.r) + (ident.pio && ident.e ? ' ' + escapeText(ident.e) : '') +
                (ident.h ? ' · ' + escapeText(ident.h) : '') + '</span>' +
              '</div>' +
              (d.a ? '<p class="drive-aka">Also sold as ' + d.a.map(function (a) {
                return escapeText(a[1].join(', ')) + ' (' + escapeText(a[0]) + ')';
              }).join(' · ') + '</p>' : '') +
              factsHtml +
              capsHtml +
              bodyHtml +
              list +
              details +
              xf;
          }

          function scrollToCard() {
            detail.scrollIntoView({ block: 'start', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
          }

          // Selecting a cross-flash target shows its firmware in the same flow.
          function showIdentity(t, vi) {
            var name = identities[t].n;
            var pick = null, revIdx = 0;
            models.some(function (d) {
              var i = d.v.findIndex(function (v) { return vi != null ? v[0] === vi : versions[v[0]].i === t; });
              if (i < 0) return false;
              if (!pick || d.m === name) { pick = d; revIdx = i; }
              return d.m === name;
            });
            if (!pick) return;
            searchInput.value = pick.m;
            selectModel(pick, '', revIdx);
            scrollToCard();
          }
          detail.addEventListener('click', function (e) {
            var b = e.target.closest('[data-xf]');
            if (b) showIdentity(Number(b.dataset.xf), b.dataset.xv != null ? Number(b.dataset.xv) : null);
            var v = e.target.closest('[data-view]');
            if (v) { curRevIdx = Number(v.dataset.view); render(); scrollToCard(); }
          });

          searchInput.addEventListener('input', function () {
            openList(filterModels(searchInput.value));
            var d = findModel(searchInput.value);
            if (d) {
              selectModel(d);
            } else {
              resetSelection();
            }
          });
          searchInput.addEventListener('focus', function () {
            if (optionsList.hidden) openList(filterModels(searchInput.value));
          });
          searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              if (optionsList.hidden) openList(filterModels(searchInput.value));
              setActive(activeIdx + 1);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              setActive(activeIdx - 1);
            } else if (e.key === 'Enter') {
              if (!optionsList.hidden && activeIdx >= 0 && filtered[activeIdx]) {
                e.preventDefault();
                choose(filtered[activeIdx]);
              }
            } else if (e.key === 'Escape') {
              closeList();
            }
          });
          // Revision combobox — click/focus opens the list; keyboard mirrors the
          // model picker. It is readonly (a fixed option set), so no typeahead.
          revInput.addEventListener('mousedown', function (e) {
            e.preventDefault();
            if (revOptions.hidden) { revInput.focus(); openRevList(); } else { closeRevList(); }
          });
          revInput.addEventListener('focus', function () {
            if (revOptions.hidden) openRevList();
          });
          revInput.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              if (revOptions.hidden) openRevList(); else setRevActive(revActiveIdx + 1);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              if (revOptions.hidden) openRevList(); else setRevActive(revActiveIdx - 1);
            } else if (e.key === 'Enter') {
              if (!revOptions.hidden && revActiveIdx >= 0) { e.preventDefault(); chooseRev(revActiveIdx); }
            } else if (e.key === 'Escape') {
              closeRevList();
            }
          });

          document.addEventListener('click', function (e) {
            if (!e.target.closest('[data-combo]')) { closeList(); closeRevList(); }
          });

          resetSelection();
        })();
      </script>
    </main>

