---
// "Find your drive" — /firmware/find/.
// Typeable search over the drive index in src/data/firmware-index.json using a
// compact custom combobox (capped, scrollable, field-width list — no native
// datalist balloon). Search matches on MODEL NAME only; brand and chip are
// never shown in the picker. Selecting a model reveals a versions dropdown,
// then a short detail card with either a download button (for a hosted base)
// or a disabled "Unavailable" button plus a "donate it on Discord" call to
// action (for a base we don't host yet — crowdsources the missing firmware).
import FirmwareNavDropdown from '../../components/FirmwareNavDropdown.astro';
import firmwareIndex from '../../data/firmware-index.json';

const title = 'Find your drive firmware — freemkv';
const description =
  'Search your optical drive model to find its firmware base image for freemkv.';

const docs = '/docs/overview/';
const github = 'https://github.com/freemkv';
const firmwareRepo = 'https://github.com/freemkv/freemkv-firmware';
const firmwareBaseUrl = 'https://pub-10fe57a98db44568abcfb5db130d3b3f.r2.dev';

// OEM base images hosted on R2 (verified HTTP 200, sha matches the index). Any
// model/revision NOT in this set shows the "ask on Discord" line, not a dead link.
// Machine-written by scripts/publish-firmware.py from the 118-image OEM corpus.
const HOSTED = new Set(['BC-12B1ST:3.01', 'BC-12B1ST:3.11', 'BC-12D2HT:3.00', 'BC-12D2HT:3.01', 'BC-12D2HT:3.11', 'BE14NU40:1.00', 'BE14NU40:1.01', 'BE16NU50:1.01', 'BE16NU50:1.02', 'BE16NU50:1.04', 'BE16NU50:INTM', 'BH14NS40:1.00', 'BH14NS40:1.01', 'BH14NS50:1.01', 'BH14NS50:1.03', 'BH14NS58:1.00', 'BH14NS58:1.01', 'BH16NS40:1.00', 'BH16NS40:1.01', 'BH16NS40:1.02', 'BH16NS40:1.03', 'BH16NS40:1.04', 'BH16NS40:1.05', 'BH16NS40:INTM', 'BH16NS48:1.02', 'BH16NS50:1.01', 'BH16NS50:1.03', 'BH16NS55:1.01', 'BH16NS55:1.02', 'BH16NS55:1.03', 'BH16NS55:1.04', 'BH16NS55:1.05', 'BH16NS58:1.00', 'BH16NS58:1.01', 'BH16NS58:1.02', 'BH16NS60:1.00', 'BH16NS60:1.02', 'BH16NS60:INTM', 'BH40N:B7C6', 'BP50NB40:1.00', 'BP50NB40:1.01', 'BP50NB40:1.02', 'BP50NB40:1.03', 'BP50NB40:INTM', 'BP55EB40:1.01', 'BP55EB40:1.02', 'BP55EB40:1.03', 'BP60NB10:1.00', 'BP60NB10:1.01', 'BP60NB10:1.02', 'BU40N:1.00', 'BU40N:1.01', 'BU40N:1.02', 'BU40N:1.03', 'BU40N:1.04', 'BU40N:BN11', 'BU40N:BN12', 'BU40N:BU10', 'BU40N:BU12', 'BU40N:BW41', 'BU40N:BW42', 'BU40N:CB04', 'BU40N:FR07', 'BU40N:INTM', 'BU40N:U100', 'BU40N:U101', 'BU50N:1.00', 'BU50N:BW51', 'BW-16D1H:A203', 'BW-16D1H:A204', 'BW-16D1HT:3.01', 'BW-16D1HT:3.02', 'BW-16D1HT:3.03', 'BW-16D1HT:3.10', 'CH12NS40:1.01', 'CH12NS40:INTM', 'UH12NS40:1.01', 'WH14NS40:1.00', 'WH14NS40:1.01', 'WH14NS40:1.02', 'WH14NS40:1.03', 'WH14NS40:1.04', 'WH14NS40:1.05', 'WH16NS40:1.01', 'WH16NS40:1.02', 'WH16NS40:1.03', 'WH16NS40:1.05', 'WH16NS58:1.V1', 'WH16NS58:1.V5', 'WH16NS60:1.00', 'WH16NS60:1.01', 'WH16NS60:1.02', 'WH16NS60:1.03', 'WP50NB40:1.01', 'WP50NB40:1.03']);
const hostedList = [...HOSTED];
// Hero summary, computed from the index so the numbers never drift: how many
// OEM base firmwares we host, broken down by chipset (largest first).
const hostedVersions = firmwareIndex.flatMap((m) =>
  m.versions.filter((v) => HOSTED.has(`${m.model}:${v.rev}`))
);
const hostedTotal = hostedVersions.length;
const hostedByChip = Object.entries(
  hostedVersions.reduce((acc, v) => {
    acc[v.chipset] = (acc[v.chipset] || 0) + 1;
    return acc;
  }, {})
).sort((a, b) => b[1] - a[1]);
import '../../styles/site.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://freemkv.org/firmware/find/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://freemkv.org/freemkv-icon.svg" />
    <meta property="og:url" content="https://freemkv.org/firmware/find/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://freemkv.org/freemkv-icon.svg" />
  </head>
  <body class="page-find">
    <!-- ============ STICKY NAV ============ -->
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">
          <img src="/freemkv-icon.svg" alt="" width="32" height="32" />
          <span>freemkv</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={docs}>Docs</a>
          <a href="/download/">Software</a>
          <FirmwareNavDropdown active="find" />
          <a
            class="nav-discord"
            href="https://discord.gg/yu7xMGTyek"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
          >
            <svg class="nav-discord-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.956-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.956 2.42-2.157 2.42zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.946 2.42-2.157 2.42z"/></svg>
          </a>
          <a
            class="gh-stars"
            href="https://github.com/freemkv/freemkv"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub stars"
            data-gh-repo="freemkv/freemkv"
          >
            <span class="gh-stars-num"><span data-gh-stars hidden></span>★</span>
            <svg class="gh-stars-logo" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero-inner">
          <h1 class="hero-title">Find your drive</h1>
          <p class="hero-lead">
            Type your drive's model number to find its firmware base image.
          </p>
          <p class="hero-stat">
            <strong>{hostedTotal}</strong> OEM firmwares available
          </p>
          <div class="hero-stat-pills">
            {hostedByChip.map(([chip, n]) => (
              <span class="stat-pill"><strong>{n}</strong> {chip}</span>
            ))}
            <span class="stat-pill stat-pill-soon">Coming soon · Pioneer</span>
          </div>
        </div>
      </section>

      <!-- ============ SEARCH ============ -->
      <section class="block">
        <div class="section-inner">
          <div class="picker">
            <div class="picker-row">
              <label class="picker-label" for="drive-search">Drive model</label>
              <div class="combo" data-combo>
                <input
                  class="picker-input"
                  id="drive-search"
                  type="text"
                  role="combobox"
                  aria-expanded="false"
                  aria-controls="drive-options"
                  aria-autocomplete="list"
                  placeholder="e.g. BU40N"
                  autocomplete="off"
                  spellcheck="false"
                />
                <ul class="picker-options" id="drive-options" role="listbox" aria-label="Drive models" hidden></ul>
              </div>
            </div>
            <div class="picker-row rev-row is-hidden" id="rev-row">
              <label class="picker-label" for="drive-rev">Firmware revision</label>
              <div class="combo" data-combo>
                <input
                  class="picker-input"
                  id="drive-rev"
                  type="text"
                  role="combobox"
                  aria-expanded="false"
                  aria-controls="rev-options"
                  aria-autocomplete="list"
                  placeholder="Select revision"
                  autocomplete="off"
                  spellcheck="false"
                  readonly
                />
                <ul class="picker-options" id="rev-options" role="listbox" aria-label="Firmware revisions" hidden></ul>
              </div>
            </div>
          </div>

          <div class="picker-detail" id="drive-detail"></div>

          <p class="block-note">
            Firmware features are structurally validated and self-verifying; the
            levers are structurally verified across the corpus. The LG BU40N is
            confirmed on live hardware; validation on the other drive families is
            the one remaining step.
          </p>

          <p class="block-note">
            Don't see your drive listed, or want to help us add one? Drop by
            <a href="https://discord.gg/yu7xMGTyek">Discord</a>.
          </p>

          <div class="next-step">
            <a class="next-step-link" href="/firmware/modify/">
              Next: modify it <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <script define:vars={{ firmwareIndex, hostedList, firmwareBaseUrl }}>
        (function () {
          var searchInput = document.getElementById('drive-search');
          var optionsList = document.getElementById('drive-options');
          var revRow = document.getElementById('rev-row');
          var revInput = document.getElementById('drive-rev');
          var revOptions = document.getElementById('rev-options');
          var detail = document.getElementById('drive-detail');
          if (!searchInput || !optionsList || !revInput || !revOptions || !detail) return;

          var hosted = {};
          hostedList.forEach(function (k) { hosted[k] = true; });

          var filtered = [];
          var activeIdx = -1;

          // Currently-selected model + revision index (the rev combobox mirrors
          // the model combobox, but its options are the chosen model's versions).
          var curModel = null;
          var curRevIdx = 0;
          var revActiveIdx = -1;

          // Number of hosted (downloadable) revisions for a model — the
          // basis for the Available/Unavailable split in the picker list.
          function hostedCount(d) {
            var n = 0;
            d.versions.forEach(function (v) {
              if (hosted[d.model + ':' + v.rev]) n++;
            });
            return n;
          }

          function findModel(name) {
            var needle = (name || '').trim().toLowerCase();
            if (!needle) return null;
            return firmwareIndex.find(function (d) { return d.model.toLowerCase() === needle; }) || null;
          }

          // Substring match on MODEL NAME only — no brand, no chip.
          function filterModels(q) {
            var needle = (q || '').trim().toLowerCase();
            if (!needle) return firmwareIndex.slice();
            return firmwareIndex.filter(function (d) {
              return d.model.toLowerCase().indexOf(needle) !== -1;
            });
          }

          function closeList() {
            optionsList.hidden = true;
            searchInput.setAttribute('aria-expanded', 'false');
            activeIdx = -1;
          }

          function addGroupLabel(text) {
            var li = document.createElement('li');
            li.className = 'picker-group-label';
            li.setAttribute('role', 'presentation');
            li.textContent = text;
            optionsList.appendChild(li);
          }

          function addOption(d, count) {
            var li = document.createElement('li');
            li.className = 'picker-option' + (count > 0 ? '' : ' picker-option-unavailable');
            li.setAttribute('role', 'option');
            li.textContent = count > 0 ? d.model + ' (' + count + ')' : d.model;
            li.addEventListener('mousedown', function (e) {
              e.preventDefault();
              choose(d);
            });
            optionsList.appendChild(li);
          }

          // Split the model list into an "Available" group (>=1 hosted
          // revision) shown first, and an "Unavailable" group (0 hosted
          // revisions) shown after — so a model with no firmware files is
          // obvious before it's ever selected.
          function openList(list) {
            optionsList.innerHTML = '';
            if (!list.length) {
              filtered = [];
              var empty = document.createElement('li');
              empty.className = 'picker-empty';
              empty.textContent = 'No matching drive models';
              optionsList.appendChild(empty);
            } else {
              var available = [];
              var unavailable = [];
              list.forEach(function (d) {
                var n = hostedCount(d);
                (n > 0 ? available : unavailable).push({ d: d, n: n });
              });
              filtered = available.concat(unavailable).map(function (e) { return e.d; });

              if (available.length) {
                addGroupLabel('Available');
                available.forEach(function (e) { addOption(e.d, e.n); });
              }
              if (unavailable.length) {
                addGroupLabel('Unavailable');
                unavailable.forEach(function (e) { addOption(e.d, e.n); });
              }
            }
            optionsList.hidden = false;
            searchInput.setAttribute('aria-expanded', 'true');
            activeIdx = -1;
          }

          function setActive(idx) {
            var opts = optionsList.querySelectorAll('.picker-option');
            if (!opts.length) return;
            if (idx < 0) idx = opts.length - 1;
            if (idx >= opts.length) idx = 0;
            for (var i = 0; i < opts.length; i++) opts[i].classList.remove('is-active');
            opts[idx].classList.add('is-active');
            opts[idx].scrollIntoView({ block: 'nearest' });
            activeIdx = idx;
          }

          function choose(d) {
            searchInput.value = d.model;
            closeList();
            selectModel(d);
          }

          // Reveal + populate the revision combobox for a model, defaulting to
          // its first version. Reserves its space when hidden (visibility toggle
          // via .is-hidden) so revealing it never shifts the page.
          function selectModel(d) {
            curModel = d;
            curRevIdx = 0;
            revInput.value = d.versions.length ? d.versions[0].rev : '';
            revRow.classList.remove('is-hidden');
            closeRevList();
            render();
          }

          // Hide the revision combobox (keeping its reserved space) and clear the
          // detail card — used whenever the model input no longer names a model.
          function resetSelection() {
            curModel = null;
            revRow.classList.add('is-hidden');
            closeRevList();
            revInput.value = '';
            detail.hidden = true;
            detail.innerHTML = '';
          }

          function closeRevList() {
            revOptions.hidden = true;
            revInput.setAttribute('aria-expanded', 'false');
            revActiveIdx = -1;
          }

          // Build + open the revision listbox — same look as the model list.
          function openRevList() {
            if (!curModel) return;
            revOptions.innerHTML = '';
            // Group revisions by brand (LG revs, then HP BWxx, …) — the same
            // model ships under multiple brands, so a brand header disambiguates.
            var byBrand = {};
            var brandOrder = [];
            curModel.versions.forEach(function (v, i) {
              var b = v.brand || curModel.brand || '';
              if (!byBrand[b]) { byBrand[b] = []; brandOrder.push(b); }
              byBrand[b].push({ v: v, i: i });
            });
            var showHeaders = brandOrder.length > 1;
            brandOrder.forEach(function (b) {
              if (showHeaders && b) {
                var lab = document.createElement('li');
                lab.className = 'picker-group-label';
                lab.setAttribute('role', 'presentation');
                lab.textContent = b;
                revOptions.appendChild(lab);
              }
              byBrand[b].forEach(function (e) {
                var li = document.createElement('li');
                li.className = 'picker-option' + (e.i === curRevIdx ? ' is-active' : '');
                li.setAttribute('role', 'option');
                li.textContent = e.v.rev;
                li.addEventListener('mousedown', function (ev) {
                  ev.preventDefault();
                  chooseRev(e.i);
                });
                revOptions.appendChild(li);
              });
            });
            revOptions.hidden = false;
            revInput.setAttribute('aria-expanded', 'true');
            revActiveIdx = curRevIdx;
          }

          function setRevActive(idx) {
            var opts = revOptions.querySelectorAll('.picker-option');
            if (!opts.length) return;
            if (idx < 0) idx = opts.length - 1;
            if (idx >= opts.length) idx = 0;
            for (var i = 0; i < opts.length; i++) opts[i].classList.remove('is-active');
            opts[idx].classList.add('is-active');
            opts[idx].scrollIntoView({ block: 'nearest' });
            revActiveIdx = idx;
          }

          function chooseRev(i) {
            curRevIdx = i;
            revInput.value = curModel.versions[i].rev;
            closeRevList();
            render();
          }

          function render() {
            var d = curModel;
            if (!d) {
              detail.innerHTML = '';
              detail.hidden = true;
              return;
            }
            detail.hidden = false;

            var v = d.versions[curRevIdx] || d.versions[0];
            var key = d.model + ':' + v.rev;
            var isHosted = !!hosted[key];

            var bodyHtml;
            if (isHosted) {
              var dlName = v.file.split('/').pop();
              bodyHtml =
                '<a class="btn btn-primary dl-btn drive-fw-btn" href="' + firmwareBaseUrl + '/' + v.file + '" download>' +
                '<span class="dl-main">Download</span>' +
                '</a>' +
                '<div class="drive-fw-hint">' +
                '<span class="drive-fw-hint-label">Then build it:</span>' +
                '<code class="drive-fw-cmd">freemkv-fw create ' + dlName + ' my-drive.freemkv.bin</code>' +
                '</div>';
            } else {
              bodyHtml =
                '<span class="btn drive-fw-btn drive-fw-btn-disabled" aria-disabled="true">Unavailable</span>' +
                '<p class="drive-fw-hint drive-fw-note">Have this firmware? ' +
                '<a class="drive-fw-link" href="https://discord.gg/yu7xMGTyek">Donate it on Discord →</a></p>';
            }

            // Tool-derived facts (from freemkv-fw create --json) — only what's
            // useful: chipset, media, region/SKU variant, and the unlocks.
            var facts = '';
            if (v.chipset) facts += '<span class="drive-fact">' + v.chipset + '</span>';
            if (v.media) facts += '<span class="drive-fact">' + v.media + '</span>';
            if (v.variant) facts += '<span class="drive-fact drive-fact-variant" title="Region/SKU code">' + v.variant + '</span>';
            // Confidence tier: BU40N is proven on real hardware; every other
            // build is strict-build + KAT verified but not yet flashed & tested.
            if (v.confidence === 'hardware-verified') {
              facts += '<span class="drive-fact drive-fact-verified" title="Proven on real hardware">Hardware-verified</span>';
            } else if (v.confidence === 'build-verified') {
              facts += '<span class="drive-fact drive-fact-buildver" title="Strict build + KAT verified; not yet flashed &amp; tested on hardware">Build-verified</span>';
            }
            var factsHtml = facts ? '<div class="drive-facts">' + facts + '</div>' : '';
            // Feature advertisement. Base-only firmware (the strict build forged a
            // real BASE but resolved no AACS feature gate — today's classic-MT1939
            // set, whose unlocks are pending a hardware boot-bless) advertises the
            // base capabilities only, never the 7 unlock flags. Everything else
            // shows the 7 real firmware flags, tinted per drive.
            var capsHtml;
            if (v.baseOnly) {
              capsHtml =
                '<div class="drive-caps drive-caps-base">' +
                '<span class="drive-caps-label">Features</span>' +
                '<span class="drive-cap drive-cap-on">Identity</span>' +
                '<span class="drive-cap drive-cap-on">Save / Reset</span>' +
                '<span class="drive-cap-note">Base only — unlock flags pending hardware validation</span>' +
                '</div>';
            } else {
              capsHtml = (v.features && v.features.length)
                ? '<div class="drive-caps"><span class="drive-caps-label">Features</span>' +
                  v.features.map(function (f) {
                    return '<span class="drive-cap ' + (f.ok ? 'drive-cap-on' : 'drive-cap-off') +
                      '">' + f.name + '</span>';
                  }).join('') +
                  '</div>'
                : '';
            }

            detail.innerHTML =
              '<div class="drive-detail-head">' +
              '<h3 class="card-title drive-title">' + (v.brand || d.brand) + ' ' + d.model + '</h3>' +
              '<span class="drive-rev">rev ' + v.rev + '</span>' +
              '</div>' +
              factsHtml +
              capsHtml +
              bodyHtml;
          }

          searchInput.addEventListener('input', function () {
            openList(filterModels(searchInput.value));
            var d = findModel(searchInput.value);
            if (d) {
              selectModel(d);
            } else {
              resetSelection();
            }
          });
          searchInput.addEventListener('focus', function () {
            if (optionsList.hidden) openList(filterModels(searchInput.value));
          });
          searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              if (optionsList.hidden) openList(filterModels(searchInput.value));
              setActive(activeIdx + 1);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              setActive(activeIdx - 1);
            } else if (e.key === 'Enter') {
              if (!optionsList.hidden && activeIdx >= 0 && filtered[activeIdx]) {
                e.preventDefault();
                choose(filtered[activeIdx]);
              }
            } else if (e.key === 'Escape') {
              closeList();
            }
          });
          // Revision combobox — click/focus opens the list; keyboard mirrors the
          // model picker. It is readonly (a fixed option set), so no typeahead.
          revInput.addEventListener('mousedown', function (e) {
            e.preventDefault();
            if (revOptions.hidden) { revInput.focus(); openRevList(); } else { closeRevList(); }
          });
          revInput.addEventListener('focus', function () {
            if (revOptions.hidden) openRevList();
          });
          revInput.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              if (revOptions.hidden) openRevList(); else setRevActive(revActiveIdx + 1);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              if (revOptions.hidden) openRevList(); else setRevActive(revActiveIdx - 1);
            } else if (e.key === 'Enter') {
              if (!revOptions.hidden && revActiveIdx >= 0) { e.preventDefault(); chooseRev(revActiveIdx); }
            } else if (e.key === 'Escape') {
              closeRevList();
            }
          });

          document.addEventListener('click', function (e) {
            if (!e.target.closest('[data-combo]')) { closeList(); closeRevList(); }
          });

          resetSelection();
        })();
      </script>
    </main>

