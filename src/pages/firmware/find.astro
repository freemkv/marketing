---
import { graph, websiteNode, orgNode, webPageNode, breadcrumbNode } from '../../lib/jsonld.mjs';
// "Find your drive" — /firmware/find/.
// Two modes on one page: "Find my firmware" (name/pasted drive string ->
// identity -> revisions) and "Find a cross-flash" (same hardware, other IDs).
// All data work lives in src/lib/finder.mjs (tested); rendering in
// src/lib/finder-view.mjs. The catalogue is prebuilt here at build time and
// embedded as JSON so the browser only hydrates and indexes it.
import FirmwareNavDropdown from '../../components/FirmwareNavDropdown.astro';
import mediatekIndex from '../../data/firmware-index.json';
import pioneerIndex from '../../data/pioneer-firmware-index.json';
import finderCatalog from '../../data/finder-catalog.json';
import { buildFinderData, clientData, hostedSummary } from '../../lib/finder.mjs';
const finderData = buildFinderData({ catalog: finderCatalog, mediatek: mediatekIndex, pioneer: pioneerIndex });
const finderJson = JSON.stringify(clientData(finderData)).replace(/</g, '\\u003c');
const { total: hostedTotal, byChip: hostedByChip } = hostedSummary(finderData);

const title = 'Find your drive firmware — freemkv';
const description =
  'Search your optical drive model to find its firmware base image for freemkv.';

const docs = '/docs/overview/';
const github = 'https://github.com/freemkv';
const firmwareRepo = 'https://github.com/freemkv/freemkv-firmware';
// Enable after configuring the Pages R2 binding and Turnstile secret in QA.
const firmwareDownloadSitekey = import.meta.env.PUBLIC_FIRMWARE_TURNSTILE_SITEKEY || '';
const protectedDownloads = Boolean(firmwareDownloadSitekey);
// Protected builds must not ship the public bucket origin at all.
const firmwareBaseUrl = protectedDownloads ? '' : 'https://pub-10fe57a98db44568abcfb5db130d3b3f.r2.dev';

import '../../styles/site.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://freemkv.org/firmware/find/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://freemkv.org/freemkv-icon.svg" />
    <meta property="og:url" content="https://freemkv.org/firmware/find/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://freemkv.org/freemkv-icon.svg" />
    <script type="application/ld+json" set:html={graph(webPageNode({ path: '/firmware/find/', name: title, description }), breadcrumbNode('/firmware/find/', [['freemkv', '/'], ['Firmware', '/firmware/'], ['Find', '/firmware/find/']]), websiteNode(), orgNode())} />
    <style is:global>
      .fx { max-width: 720px; margin: 0 auto; }
      .fx-tabs { display: flex; gap: 0.25rem; padding: 0.25rem; margin: 0 auto 1.25rem; width: fit-content; max-width: 100%; border: 1.5px solid var(--line); border-radius: 12px; background: var(--bg-soft); }
      .fx-tab { font: inherit; font-weight: 650; font-size: 0.95rem; color: var(--slate); background: transparent; border: 0; border-radius: 9px; padding: 0.55rem 1rem; cursor: pointer; }
      .fx-tab.is-active { background: #fff; color: var(--teal-darker); box-shadow: 0 2px 8px -4px rgba(15, 23, 42, 0.3); }
      .fx-tab:focus-visible, .fx-result:focus-visible, .fx-suggest:focus-visible, .fx-link:focus-visible, .gloss:focus-visible { outline: 3px solid rgba(13, 148, 136, 0.45); outline-offset: 2px; }
      .fx-direction { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; margin: 0 0 0.9rem; font-size: 0.92rem; color: var(--slate); }
      .fx-direction[hidden] { display: none; }
      .fx-seg { display: inline-flex; gap: 0.9rem; flex-wrap: wrap; }
      .fx-seg label { display: inline-flex; gap: 0.35rem; align-items: center; cursor: pointer; }
      .fx-help { margin: 0.2rem 0 0; color: var(--muted); font-size: 0.85rem; }
      .fx-help code, .fx-howto code, .fx-empty code { font-size: 0.82em; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 5px; padding: 0.05rem 0.3rem; overflow-wrap: anywhere; }
      .fx-status { min-height: 1.2em; margin: 0.6rem 0 0; font-size: 0.85rem; color: var(--muted); }
      .fx-group { margin-top: 0.9rem; }
      .fx-group-title { margin: 0 0 0.35rem; font-size: 0.75rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--teal-dark); }
      .fx-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
      .fx-result { width: 100%; text-align: left; font: inherit; display: grid; grid-template-columns: 1fr auto; gap: 0.1rem 0.75rem; padding: 0.6rem 0.85rem; border: 1.5px solid var(--line); border-radius: 10px; background: #fff; cursor: pointer; }
      .fx-result:hover { border-color: var(--teal); background: var(--teal-tint); }
      .fx-result-name { font-weight: 650; color: var(--ink); overflow-wrap: anywhere; }
      .fx-result-count { font-size: 0.78rem; color: var(--muted); align-self: center; }
      .fx-why { grid-column: 1 / -1; font-size: 0.82rem; color: var(--slate); }
      .fx-empty { padding: 0.9rem 1rem; border: 1.5px dashed var(--line); border-radius: 10px; color: var(--slate); font-size: 0.92rem; }
      .fx-empty p { margin: 0.3rem 0; }
      .fx-suggest, .fx-link { font: inherit; color: var(--teal-dark); background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; }
      .fx-detail { max-width: 720px; }
      .fx-detail:focus { outline: none; }
      .fx-h { margin: 1.4rem 0 0.5rem; font-size: 1rem; }
      .fx-lead, .fx-aka { color: var(--slate); font-size: 0.92rem; margin: 0.4rem 0; }
      .fx-muted { color: var(--muted); font-size: 0.88rem; margin: 0.3rem 0; }
      .fx-sub { margin: 0.7rem 0 0.2rem; font-weight: 650; font-size: 0.88rem; }
      .fx-checklist { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; font-size: 0.92rem; }
      .fx-checklist li { display: flex; gap: 0.5rem; align-items: baseline; flex-wrap: wrap; }
      .fx-check { display: inline-grid; place-items: center; width: 1.3rem; height: 1.3rem; border-radius: 999px; font-weight: 800; font-size: 0.8rem; flex: none; }
      .fx-check-ok { background: #ecfdf3; color: #067647; }
      .fx-check-bad { background: #fef3f2; color: #b42318; }
      .fx-check-ask { background: var(--bg-soft); color: var(--slate); border: 1px solid var(--line); }
      .fx-term { font-size: 0.75rem; color: var(--muted); }
      .fx-warn { padding: 0.65rem 0.85rem; border-radius: 10px; background: #fffaeb; border: 1px solid #fedf89; color: #93370d; font-size: 0.9rem; }
      .fx-recommend { margin: 1rem 0 0.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem; align-items: center; }
      .fx-file { font-size: 0.82rem; color: var(--muted); overflow-wrap: anywhere; }
      .fx-provenance { font-size: 0.85rem; color: var(--slate); margin: 0.6rem 0; }
      .fx-timeline { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--line); }
      .fx-rev { position: relative; padding: 0.35rem 0 0.35rem 1rem; font-size: 0.92rem; display: flex; flex-wrap: wrap; gap: 0.3rem 0.6rem; align-items: baseline; }
      .fx-rev::before { content: ""; position: absolute; left: -6px; top: 0.75rem; width: 10px; height: 10px; border-radius: 999px; background: var(--teal); }
      .fx-rev-missing::before { background: #fff; border: 2px solid var(--muted); width: 6px; height: 6px; }
      .fx-rev-num { font-weight: 700; font-family: var(--mono); }
      .fx-missing { color: var(--muted); font-size: 0.85rem; }
      .fx-tag { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--teal-darker); background: var(--teal-tint); border-radius: 5px; padding: 0.05rem 0.4rem; }
      .fx-tag-yours { color: var(--slate); background: var(--bg-soft); }
      .fx-rev-dl { font-size: 0.85rem; font-weight: 600; }
      .fx-details { margin-top: 1rem; font-size: 0.85rem; }
      .fx-details summary { cursor: pointer; color: var(--slate); font-weight: 600; }
      .fx-table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; display: block; overflow-x: auto; }
      .fx-table th, .fx-table td { text-align: left; padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
      .fx-sha { font-size: 0.75rem; overflow-wrap: anywhere; word-break: break-all; }
      .fx-convert { margin-top: 1.4rem; padding-top: 0.6rem; border-top: 1px solid var(--line); }
      .fx-convert-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.3rem; font-size: 0.9rem; }
      .fx-badge { display: inline-block; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.03em; border-radius: 999px; padding: 0.12rem 0.55rem; }
      .fx-badge-proven { background: #ecfdf3; color: #067647; border: 1px solid #abefc6; }
      .fx-badge-likely { background: #eff8ff; color: #175cd3; border: 1px solid #b2ddff; }
      .fx-badge-untested { background: #fffaeb; color: #93370d; border: 1px solid #fedf89; }
      .fx-xf-card { border: 1.5px solid var(--line); border-radius: 12px; padding: 0.9rem 1rem; margin: 0.6rem 0; font-size: 0.92rem; }
      .fx-xf-title { margin: 0; font-size: 1rem; }
      .fx-xf-card ul, .fx-xf-card ol { margin: 0.2rem 0; padding-left: 1.2rem; }
      .fx-evidence li { color: var(--slate); }
      .fx-howto { margin-top: 1rem; padding: 0.75rem 0.9rem; background: var(--bg-soft); border-radius: 10px; font-size: 0.88rem; color: var(--slate); }
      .fx-howto-title { margin: 0 0 0.3rem; font-weight: 700; color: var(--ink); }
      .fx-howto ul { margin: 0; padding-left: 1.1rem; }
      .fx-browse-wrap { margin-top: 1.5rem; font-size: 0.92rem; }
      .fx-browse-wrap > summary { cursor: pointer; font-weight: 650; color: var(--teal-dark); }
      .fx-browse details { margin: 0.3rem 0 0.3rem 0.9rem; }
      .fx-browse summary { cursor: pointer; }
      .fx-browse-hw { list-style: none; margin: 0.2rem 0 0.4rem 1rem; padding: 0; columns: 2 14rem; }
      .fx-count { color: var(--muted); font-size: 0.8rem; }
      .gloss { border-bottom: 1px dotted currentColor; cursor: help; position: relative; }
      .gloss-tip { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .gloss:hover .gloss-tip, .gloss:focus .gloss-tip { left: 0; top: calc(100% + 0.35rem); z-index: 40; width: min(18rem, 70vw); height: auto; overflow: visible; clip-path: none; white-space: normal; padding: 0.5rem 0.65rem; border-radius: 8px; background: var(--ink); color: #fff; font-size: 0.78rem; font-weight: 500; line-height: 1.4; text-transform: none; letter-spacing: 0; pointer-events: none; }
      @media (max-width: 560px) { .fx-tab { padding: 0.5rem 0.7rem; font-size: 0.88rem; } .fx-result { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body class="page-find">
    <!-- ============ STICKY NAV ============ -->
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">
          <img src="/freemkv-icon.svg" alt="" width="32" height="32" />
          <span>freemkv</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={docs}>Docs</a>
          <a href="/download/">Software</a>
          <FirmwareNavDropdown active="find" />
          <a
            class="nav-discord"
            href="https://discord.gg/yu7xMGTyek"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
          >
            <svg class="nav-discord-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.956-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.956 2.42-2.157 2.42zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.946 2.42-2.157 2.42z"/></svg>
          </a>
          <a
            class="gh-stars"
            href="https://github.com/freemkv/freemkv"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub stars"
            data-gh-repo="freemkv/freemkv"
          >
            <span class="gh-stars-num"><span data-gh-stars hidden></span>★</span>
            <svg class="gh-stars-logo" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero-inner">
          <h1 class="hero-title">Find your drive</h1>
          <p class="hero-lead">
            Find the exact firmware for your drive, or see which other editions it can become.
          </p>
          <p class="hero-stat">
            <strong>{hostedTotal}</strong> OEM firmwares available
          </p>
          <div class="hero-stat-pills">
            {hostedByChip.map(([chip, n]) => (
              <span class="stat-pill"><strong>{n}</strong> {chip}</span>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ FINDER ============ -->
      <section class="block">
        <div class="section-inner">
          <div class="fx" id="finder" data-base-url={firmwareBaseUrl || undefined} data-protected={protectedDownloads ? '1' : ''}>
            <div class="fx-tabs" role="tablist" aria-label="What do you want to do?">
              <button type="button" role="tab" id="tab-firmware" aria-controls="fx-panel" aria-selected="true" data-mode="firmware" class="fx-tab is-active">Find my firmware</button>
              <button type="button" role="tab" id="tab-crossflash" aria-controls="fx-panel" aria-selected="false" data-mode="crossflash" class="fx-tab" tabindex="-1">Find a cross-flash</button>
            </div>
            <div id="fx-panel" role="tabpanel" aria-labelledby="tab-firmware">
              <div class="fx-direction" id="fx-direction" hidden>
                <span class="fx-direction-label" id="fx-direction-label">I’m entering</span>
                <div role="radiogroup" aria-labelledby="fx-direction-label" class="fx-seg">
                  <label><input type="radio" name="fx-direction" value="from" checked /> my drive</label>
                  <label><input type="radio" name="fx-direction" value="to" /> the edition I want</label>
                </div>
              </div>
              <div class="picker-row">
                <label class="picker-label" for="drive-search" id="fx-search-label">Your drive</label>
                <input
                  class="picker-input"
                  id="drive-search"
                  type="search"
                  aria-describedby="fx-search-help"
                  aria-controls="fx-results"
                  placeholder="e.g. BDR-S13U, BU40N, 8510 ID19"
                  autocomplete="off"
                  spellcheck="false"
                />
                <p class="fx-help" id="fx-search-help">
                  Type the model, or paste what your computer or MakeMKV shows for the drive
                  (for example <code>PIONEER BD-RW BDR-UD02D 1.01</code> or <code>Drive platform: Pioneer RS8410</code> / <code>Firmware version: ID84</code>).
                  Hardware plus ID (<code>8510 ID19</code>) and chipsets (<code>MT1959</code>) work too.
                </p>
              </div>
              <p class="fx-status" id="fx-status" role="status" aria-live="polite"></p>
              <div class="fx-results" id="fx-results"></div>
              <div class="picker-detail fx-detail" id="drive-detail" tabindex="-1" hidden></div>
              <div class="next-step" id="modify-next-step" hidden>
                <a class="next-step-link" id="firmware-next-link" href="/firmware/flash/">
                  Next: flash it <span aria-hidden="true">→</span>
                </a>
              </div>
              <details class="fx-browse-wrap" id="fx-browse">
                <summary>Browse all drives by brand</summary>
                <div id="fx-browse-body"></div>
              </details>
            </div>
          </div>

          <p class="block-note" id="modify-feature-note" hidden>
            Firmware features are structurally validated and self-verifying; the
            levers are structurally verified across the corpus.
          </p>

          <p class="block-note">
            Don't see your drive listed, or want to help us add one? Drop by <a href="https://discord.gg/yu7xMGTyek">Discord</a>.
          </p>
        </div>
      </section>

      <script type="application/json" id="finder-data" set:html={finderJson}></script>
      {protectedDownloads && <div id="firmware-download-config" data-sitekey={firmwareDownloadSitekey} hidden />}
      {protectedDownloads && <script is:inline type="module" src="/firmware-download.js"></script>}
      <script>
        import { startFinder } from '../../lib/finder-page.mjs';
        startFinder(document, window);
      </script>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="section-inner footer-inner">
        <div class="footer-brand">
          <img src="/freemkv-icon.svg" alt="" width="28" height="28" />
          <span>freemkv</span>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={github}>GitHub</a>
          <a href="https://github.com/freemkv/freemkv/blob/main/LICENSE">License (MIT)</a>
        </nav>
      </div>
      <p class="footer-copy">MIT · Recover 100% of readable data from any optical disc.</p>
    </footer>

    <script is:inline>
      (function () {
        var el = document.querySelector('a.gh-stars');
        if (!el) return;
        var repo = el.dataset.ghRepo;
        var countEl = el.querySelector('[data-gh-stars]');
        if (!repo || !countEl) return;
        var CACHE_KEY = 'freemkv:gh-stars:' + repo;
        var TTL_MS = 60 * 60 * 1000;
        function format(n) {
          if (!isFinite(n) || n < 0) return '';
          if (n < 1000) return String(n);
          var k = n / 1000;
          var s = k < 10 ? k.toFixed(1) : Math.round(k).toString();
          return s.replace(/\.0$/, '') + 'k';
        }
        function show(n) {
          var text = format(n);
          if (!text) return;
          countEl.textContent = text;
          countEl.hidden = false;
          el.setAttribute('aria-label', 'GitHub stars: ' + n.toLocaleString());
        }
        try {
          var raw = localStorage.getItem(CACHE_KEY);
          if (raw) {
            var cached = JSON.parse(raw);
            if (cached && typeof cached.count === 'number') {
              show(cached.count);
              if (Date.now() - cached.ts < TTL_MS) return;
            }
          }
        } catch (e) {}
        fetch('https://api.github.com/repos/' + repo, {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
          .then(function (data) {
            var count = data && data.stargazers_count;
            if (typeof count !== 'number') return;
            show(count);
            try { localStorage.setItem(CACHE_KEY, JSON.stringify({ count: count, ts: Date.now() })); } catch (e) {}
          })
          .catch(function () {});
      })();
    </script>

  </body>
</html>
