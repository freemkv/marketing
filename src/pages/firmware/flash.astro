---
// "Flash" — /firmware/flash/. freemkv-flash: a generic MT19xx optical-drive
// flasher/dumper — not freemkv-specific — that backs up before writing and
// verifies after. Carries the download link for the freemkv-flash binary,
// reusing the release-asset button pattern from src/pages/download.astro.
import FirmwareNavDropdown from '../../components/FirmwareNavDropdown.astro';

const title = 'freemkv-flash — flash your drive';
const description =
  'freemkv-flash is a generic MediaTek optical-drive flasher and dumper. It backs up before writing and verifies after.';

const docs = '/docs/overview/';
const github = 'https://github.com/freemkv';
const firmwareRepo = 'https://github.com/freemkv/freemkv-firmware';
const firmwareReleases = `${firmwareRepo}/releases`;

const platforms = [
  {
    name: 'Windows',
    os: 'windows',
    builds: [
      { arch: 'x86_64', label: 'Intel / AMD 64-bit', slug: 'windows-x86_64', ext: 'zip' },
    ],
  },
  {
    name: 'macOS',
    os: 'macos',
    builds: [
      { arch: 'ARM64', label: 'Apple Silicon', slug: 'macos-arm64', ext: 'tar.gz' },
      { arch: 'x86_64', label: 'Intel', slug: 'macos-x86_64', ext: 'tar.gz' },
    ],
  },
  {
    name: 'Linux',
    os: 'linux',
    builds: [
      { arch: 'x86_64', label: 'Intel / AMD 64-bit', slug: 'linux-x86_64', ext: 'tar.gz' },
    ],
  },
];

const assetFor = (tool, b) => `freemkv-${tool}-${b.slug}.${b.ext}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://freemkv.org/firmware/flash/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://freemkv.org/freemkv-icon.svg" />
    <meta property="og:url" content="https://freemkv.org/firmware/flash/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://freemkv.org/freemkv-icon.svg" />
  </head>
  <body>
    <!-- ============ STICKY NAV ============ -->
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">
          <img src="/freemkv-icon.svg" alt="" width="32" height="32" />
          <span>freemkv</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={docs}>Docs</a>
          <a href="/download/">Software</a>
          <FirmwareNavDropdown active="flash" />
          <a
            class="nav-discord"
            href="https://discord.gg/yu7xMGTyek"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
          >
            <svg class="nav-discord-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.956-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.956 2.42-2.157 2.42zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.946 2.42-2.157 2.42z"/></svg>
          </a>
          <a
            class="gh-stars"
            href="https://github.com/freemkv/freemkv"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub stars"
            data-gh-repo="freemkv/freemkv"
          >
            <span class="gh-stars-num"><span data-gh-stars hidden></span>★</span>
            <svg class="gh-stars-logo" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero-inner">
          <h1 class="hero-title">freemkv-flash</h1>
          <div class="hero-badge">
            <span class="hero-badge-dot" aria-hidden="true"></span>
            <span>Beta · flashing is experimental</span>
          </div>
          <p class="hero-lead">
            A generic MediaTek (MT19xx) optical-drive flasher and dumper.
            <strong>Not freemkv-specific</strong> — it flashes and dumps any
            MTK firmware image, for any purpose. It always backs up before
            writing, and reads back after every write to confirm it took.
          </p>
        </div>
      </section>

      <!-- ============ FLASH ============ -->
      <section class="block">
        <div class="section-inner">
          <ol class="steps steps-compact">
            <li class="step">
              <span class="step-num">1</span>
              <span class="step-title">Probe</span>
              <span class="step-desc"><code>info</code> identifies the drive before you touch anything.</span>
            </li>
            <li class="step">
              <span class="step-num">2</span>
              <span class="step-title">Dump / back up</span>
              <span class="step-desc">Always keep the stock image before flashing.</span>
            </li>
            <li class="step">
              <span class="step-num">3</span>
              <span class="step-title">Flash</span>
              <span class="step-desc">Writes the image, then automatically reads it back to confirm.</span>
            </li>
          </ol>

          <div class="terminal">
            <div class="terminal-bar" aria-hidden="true">
              <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
              <span class="terminal-title">freemkv-flash</span>
            </div>
            <pre class="terminal-body"><code><span class="c"># 1. Identify the drive first — any MTK optical drive</span>
<span class="p">$</span> freemkv-flash info &lt;dev&gt;

<span class="c"># 2. Always dump before touching anything — full image + read-surface map</span>
<span class="p">$</span> freemkv-flash dump &lt;dev&gt;

<span class="c"># 3. Flash — backs up automatically, writes, then reads back to verify</span>
<span class="p">$</span> freemkv-flash flash &lt;dev&gt; -i BU40N_1.00.freemkv.bin</code></pre>
          </div>

          <div class="notice">
            <h2 class="notice-title">Beta — <code>info</code> and <code>dump</code> are the safe, recommended commands</h2>
            <p>
              <code>freemkv-flash</code> is tested on a single model (LG
              BU40N). <code>info</code> and <code>dump</code> are read-only
              and safe to run on any supported drive today. <code>flash</code>
              is experimental — it can permanently brick a drive if
              interrupted or given the wrong image. It backs up before
              writing and reads back after, but always keep your own dump too.
            </p>
          </div>

          <div class="grid dl-grid">
            {platforms.map((p) => (
              <article class="card" data-os={p.os}>
                <h3 class="card-title">{p.name}</h3>
                <div class="dl-list">
                  {p.builds.map((b) => (
                    <a
                      class="btn btn-primary dl-btn"
                      href={`${firmwareRepo}/releases/latest/download/${assetFor('flash', b)}`}
                      download
                    >
                      <span class="dl-main">Download <span class="dl-arch">{b.arch}</span></span>
                      <span class="dl-sub">{b.label}</span>
                    </a>
                  ))}
                </div>
              </article>
            ))}
          </div>
          <p class="dl-note">
            <a href={firmwareReleases}>All releases on GitHub →</a>
            <a href={firmwareRepo}>View on GitHub →</a>
          </p>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="section-inner footer-inner">
        <div class="footer-brand">
          <img src="/freemkv-icon.svg" alt="" width="28" height="28" />
          <span>freemkv</span>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={github}>GitHub</a>
          <a href="https://github.com/freemkv/freemkv/blob/main/LICENSE">License (MIT)</a>
        </nav>
      </div>
      <p class="footer-copy">MIT · Recover 100% of readable data from any optical disc.</p>
    </footer>

    <script is:inline>
      (function () {
        var el = document.querySelector('a.gh-stars');
        if (!el) return;
        var repo = el.dataset.ghRepo;
        var countEl = el.querySelector('[data-gh-stars]');
        if (!repo || !countEl) return;
        var CACHE_KEY = 'freemkv:gh-stars:' + repo;
        var TTL_MS = 60 * 60 * 1000;
        function format(n) {
          if (!isFinite(n) || n < 0) return '';
          if (n < 1000) return String(n);
          var k = n / 1000;
          var s = k < 10 ? k.toFixed(1) : Math.round(k).toString();
          return s.replace(/\.0$/, '') + 'k';
        }
        function show(n) {
          var text = format(n);
          if (!text) return;
          countEl.textContent = text;
          countEl.hidden = false;
          el.setAttribute('aria-label', 'GitHub stars: ' + n.toLocaleString());
        }
        try {
          var raw = localStorage.getItem(CACHE_KEY);
          if (raw) {
            var cached = JSON.parse(raw);
            if (cached && typeof cached.count === 'number') {
              show(cached.count);
              if (Date.now() - cached.ts < TTL_MS) return;
            }
          }
        } catch (e) {}
        fetch('https://api.github.com/repos/' + repo, {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
          .then(function (data) {
            var count = data && data.stargazers_count;
            if (typeof count !== 'number') return;
            show(count);
            try { localStorage.setItem(CACHE_KEY, JSON.stringify({ count: count, ts: Date.now() })); } catch (e) {}
          })
          .catch(function () {});
      })();
    </script>

    <style>
      :root {
        --teal: #0d9488;
        --teal-dark: #0f766e;
        --teal-darker: #115e59;
        --teal-tint: #f0fdfa;
        --ink: #0f172a;
        --slate: #475569;
        --muted: #64748b;
        --line: #e2e8f0;
        --bg: #ffffff;
        --bg-soft: #f8fafc;
        --radius: 14px;
        --maxw: 1080px;
        --font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: var(--font);
        color: var(--ink);
        background: var(--bg);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--teal-dark); text-decoration: none; }
      a:hover { color: var(--teal-darker); }
      code {
        font-family: var(--mono);
        font-size: 0.9em;
        background: var(--teal-tint);
        color: var(--teal-darker);
        padding: 0.1em 0.35em;
        border-radius: 5px;
      }

      .section-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 0 clamp(1rem, 4vw, 2rem);
      }

      /* ---------- NAV ---------- */
      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: saturate(180%) blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .nav-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 0.75rem clamp(1rem, 4vw, 2rem);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-weight: 750;
        font-size: 1.15rem;
        color: var(--ink);
        letter-spacing: -0.01em;
      }
      .brand img { display: block; }
      .nav-links {
        display: flex;
        gap: clamp(0.75rem, 3vw, 1.75rem);
        align-items: center;
        flex-wrap: wrap;
      }
      .nav-links a {
        color: var(--slate);
        font-weight: 550;
        font-size: 0.95rem;
      }
      .nav-links a:hover { color: var(--teal-dark); }
      .nav-links a[aria-current="page"] { color: var(--teal-dark); font-weight: 650; }
      .nav-links a.gh-stars {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        font-variant-numeric: tabular-nums;
      }
      .gh-stars-num { line-height: 1; white-space: nowrap; }
      .gh-stars-logo { width: 1.2em; height: 1.2em; }
      .nav-links a.nav-discord {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
      }
      .nav-discord-logo { width: 1.15em; height: 1.15em; }

      /* ---------- BUTTONS ---------- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.7rem 1.3rem;
        border-radius: 10px;
        font-weight: 650;
        font-size: 0.98rem;
        border: 1.5px solid transparent;
        transition: transform 0.05s ease, background 0.15s ease, border-color 0.15s ease;
        white-space: nowrap;
        max-width: 100%;
      }
      .btn:active { transform: translateY(1px); }
      .btn-primary {
        background: var(--teal);
        color: #fff;
        box-shadow: 0 6px 18px -8px rgba(13, 148, 136, 0.7);
      }
      .btn-primary:hover { background: var(--teal-dark); color: #fff; }

      /* ---------- HERO ---------- */
      .hero {
        background:
          radial-gradient(60% 120% at 50% -10%, rgba(13, 148, 136, 0.1), transparent 60%),
          var(--bg-soft);
        border-bottom: 1px solid var(--line);
        padding: clamp(2.5rem, 8vw, 4.5rem) 0 clamp(2.25rem, 6vw, 3.5rem);
      }
      .hero-inner {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 clamp(1rem, 4vw, 2rem);
        text-align: center;
      }
      .hero-title {
        font-size: clamp(2rem, 7vw, 3rem);
        line-height: 1.08;
        font-weight: 800;
        letter-spacing: -0.03em;
        margin: 0 0 0.75rem;
      }
      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.4rem 0.95rem;
        border: 1px solid var(--border, rgba(127, 127, 127, 0.3));
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--slate);
      }
      .hero-badge-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
      }
      .hero-lead {
        margin: 1.25rem auto 0;
        max-width: 56ch;
        color: var(--slate);
        font-size: clamp(1rem, 2.5vw, 1.12rem);
      }

      /* ---------- CONTENT BLOCKS ---------- */
      .block { padding: clamp(2.5rem, 7vw, 4rem) 0; }

      /* ---------- DOWNLOAD CARDS ---------- */
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: clamp(1rem, 3vw, 1.5rem);
      }
      .dl-grid { margin-top: 2rem; }
      .card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.75rem 1.5rem;
        text-align: center;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
      }
      .card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 34px -18px rgba(15, 23, 42, 0.25);
        border-color: #cbd5e1;
      }
      .card-title {
        font-size: 1.3rem;
        margin: 0 0 1.1rem;
        letter-spacing: -0.01em;
      }
      .dl-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .dl-btn {
        flex-direction: column;
        gap: 0.1rem;
        padding: 0.7rem 1rem;
        width: 100%;
        line-height: 1.3;
        white-space: normal;
      }
      .dl-main { font-size: 1rem; }
      .dl-arch {
        font-family: var(--mono);
        font-size: 0.85em;
        opacity: 0.95;
      }
      .dl-sub {
        font-size: 0.78rem;
        font-weight: 500;
        opacity: 0.85;
        white-space: normal;
      }
      .dl-note {
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
        margin: 2rem auto 0;
        max-width: 60ch;
      }
      .dl-note a { margin-left: 0.4rem; font-weight: 600; }

      /* ---------- HOW-IT-WORKS STEPS ---------- */
      .steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: clamp(1rem, 3vw, 1.5rem);
        max-width: 900px;
        margin: 0 auto 2.5rem;
        padding: 0;
        list-style: none;
        counter-reset: step;
      }
      .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        text-align: center;
        padding: 1.25rem 1rem;
        background: var(--bg-soft);
        border: 1px solid var(--line);
        border-radius: var(--radius);
      }
      .step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        background: var(--teal);
        color: #fff;
        font-weight: 750;
        font-size: 0.95rem;
        margin-bottom: 0.25rem;
      }
      .step-title { font-weight: 700; color: var(--ink); font-size: 1rem; }
      .step-desc { color: var(--muted); font-size: 0.88rem; }
      .steps-compact { margin-bottom: 2rem; max-width: 780px; }

      /* ---------- NOTICE ---------- */
      .notice {
        max-width: 640px;
        margin: 0 auto;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: var(--radius);
        padding: 1.5rem 1.75rem;
        text-align: center;
      }
      .notice-title {
        font-size: 1.2rem;
        font-weight: 750;
        margin: 0 0 0.5rem;
        color: #92400e;
      }
      .notice p { margin: 0; color: var(--slate); font-size: 0.95rem; }
      .notice code {
        background: #fef3c7;
        color: #92400e;
      }

      /* ---------- TERMINAL ---------- */
      .terminal {
        max-width: 720px;
        margin: 0 auto 2.5rem;
        background: #0b1220;
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: 0 24px 60px -28px rgba(15, 23, 42, 0.55);
        border: 1px solid #1e293b;
        text-align: left;
      }
      .terminal-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 0.9rem;
        background: #111a2e;
        border-bottom: 1px solid #1e293b;
      }
      .dot { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
      .dot-r { background: #ff5f56; }
      .dot-y { background: #ffbd2e; }
      .dot-g { background: #27c93f; }
      .terminal-title {
        margin-left: 0.6rem;
        color: #64748b;
        font-size: 0.78rem;
        font-family: var(--mono);
      }
      .terminal-body {
        margin: 0;
        padding: 1.25rem;
        overflow-x: auto;
        color: #e2e8f0;
        font-family: var(--mono);
        font-size: clamp(0.78rem, 2.2vw, 0.92rem);
        line-height: 1.7;
        text-align: left;
      }
      .terminal-body code { background: none; color: inherit; padding: 0; }
      .terminal-body .c { color: #64748b; }
      .terminal-body .p { color: #2dd4bf; }

      /* ---------- FOOTER ---------- */
      .footer {
        background: var(--ink);
        color: #cbd5e1;
        padding: 2.5rem 0 1.75rem;
      }
      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        color: #fff;
      }
