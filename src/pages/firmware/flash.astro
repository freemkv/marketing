---
import { latestRelease } from '../../lib/releases.mjs';
const release = await latestRelease('freemkv-firmware');
import { graph, websiteNode, orgNode, webPageNode, breadcrumbNode, firmwareToolNode, ID } from '../../lib/jsonld.mjs';
// "Flash" — /firmware/flash/. freemkv-flash: a generic MT19xx optical-drive
// flasher/dumper — not freemkv-specific — that backs up before writing and
// verifies after. Carries the download link for the freemkv-flash binary,
// reusing the release-asset button pattern from src/pages/download.astro.
import FirmwareNavDropdown from '../../components/FirmwareNavDropdown.astro';
import FirmwareDownloadToolbar from '../../components/FirmwareDownloadToolbar.astro';
import DownloadCards from '../../components/DownloadCards.astro';
import { aptSetup, rpmSetup, pacmanSetup, scoopSetup, linuxHelp, windowsHelp } from '../../lib/install-commands.mjs';

const title = 'freemkv-flash — flash your drive';
const description =
  'freemkv-flash is a generic optical-drive flasher and dumper. It backs up before writing and verifies after.';

const docs = '/docs/overview/';
const github = 'https://github.com/freemkv';
const firmwareRepo = 'https://github.com/freemkv/freemkv-firmware';
const firmwareReleases = `${firmwareRepo}/releases`;

// One box per install method, as on /download/. Every app download carries the
// CLI; macOS is Homebrew only (not notarized). Asset names follow
// freemkv-firmware's release.yml.
const tool = 'freemkv-flash';
const platforms = [
  {
    name: 'Windows',
    os: 'windows',
    methods: [
      {
        title: 'Scoop',
        hint: 'x86_64 and ARM64 · app and command line',
        commands: [scoopSetup, `scoop install ${tool}`],
      },
      {
        title: 'Download',
        builds: [
          { key: 'windows-x86_64', main: 'Installer', arch: 'x86_64', label: 'App + CLI on PATH · Start menu shortcut', file: `${tool}-x86_64-windows-setup.exe` },
          { main: 'Portable', arch: '.zip', label: 'App + CLI, no install', file: `${tool}-x86_64-windows.zip`, secondary: true },
          { key: 'windows-arm64', main: 'Installer', arch: 'ARM64', label: 'Windows on ARM', file: `${tool}-aarch64-windows-setup.exe`, secondary: true },
          { main: 'Portable', arch: 'ARM64 .zip', label: 'Windows on ARM, no install', file: `${tool}-aarch64-windows.zip`, secondary: true },
        ],
      },
    ],
    footnote: windowsHelp,
  },
  {
    name: 'macOS',
    os: 'macos',
    methods: [
      {
        title: 'Homebrew',
        hint: 'Apple Silicon or Intel',
        commands: [`brew install freemkv/tap/${tool}-gui`],
        note: 'Installs the app and the command line (or <code>brew install freemkv/tap/' + tool + '</code> for the command line only). Not notarized, so macOS installs go through Homebrew only.',
      },
    ],
  },
  {
    name: 'Linux',
    os: 'linux',
    methods: [
      {
        title: 'APT',
        hint: 'Ubuntu 24.04+, Mint 22, Debian 13 · recommended',
        commands: [...aptSetup, `sudo apt update && sudo apt install ${tool}-gui`],
        note: `<code>${tool}-gui</code> is the app plus the command line; <code>${tool}</code> is the command line only.`,
      },
      {
        title: 'DNF',
        hint: 'Fedora 40+',
        commands: [rpmSetup, `sudo dnf install ${tool}-gui`],
      },
      {
        title: 'pacman',
        hint: 'Arch Linux',
        commands: [...pacmanSetup, `sudo pacman -Syu ${tool}-gui`],
      },
      {
        title: 'Download',
        builds: [
          { key: 'linux-x86_64', arch: '.deb', label: 'App + CLI · x86_64', file: `${tool}-gui-amd64.deb` },
          { key: 'linux-arm64', arch: 'ARM64 .deb', label: 'App + CLI · aarch64', file: `${tool}-gui-arm64.deb`, secondary: true },
          { arch: 'AppImage', label: 'Portable app + CLI · x86_64', file: `${tool}-x86_64-linux.AppImage`, secondary: true },
          { arch: 'ARM64 AppImage', label: 'Portable app + CLI · aarch64', file: `${tool}-aarch64-linux.AppImage`, secondary: true },
          { arch: 'CLI', label: 'Static binary · x86_64, any distro', file: `${tool}-cli-x86_64-linux`, secondary: true },
          { arch: 'CLI ARM64', label: 'Static binary · aarch64', file: `${tool}-cli-aarch64-linux`, secondary: true },
          { arch: 'CLI ARMv7', label: 'Static binary · Raspberry Pi OS 32-bit', file: `${tool}-cli-armv7-linux`, secondary: true },
        ],
      },
    ],
    footnote: linuxHelp,
  },
];

import '../../styles/site.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://freemkv.org/firmware/flash/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://freemkv.org/freemkv-icon.svg" />
    <meta property="og:url" content="https://freemkv.org/firmware/flash/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://freemkv.org/freemkv-icon.svg" />
    <script type="application/ld+json" set:html={graph(webPageNode({ path: '/firmware/flash/', name: title, description, about: ID.flash }), breadcrumbNode('/firmware/flash/', [['freemkv', '/'], ['Firmware', '/firmware/'], ['Flash', '/firmware/flash/']]), firmwareToolNode({ id: ID.flash, name: 'freemkv-flash', description, url: 'https://freemkv.org/firmware/flash/' }), websiteNode(), orgNode())} />
  </head>
  <body class="page-flash">
    <!-- ============ STICKY NAV ============ -->
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">
          <img src="/freemkv-icon.svg" alt="" width="32" height="32" />
          <span>freemkv</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={docs}>Docs</a>
          <a href="/download/">Software</a>
          <FirmwareNavDropdown active="flash" />
          <a
            class="nav-discord"
            href="https://discord.gg/yu7xMGTyek"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
          >
            <svg class="nav-discord-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.956-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.956 2.42-2.157 2.42zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.946 2.42-2.157 2.42z"/></svg>
          </a>
          <a
            class="gh-stars"
            href="https://github.com/freemkv/freemkv"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub stars"
            data-gh-repo="freemkv/freemkv"
          >
            <span class="gh-stars-num"><span data-gh-stars hidden></span>★</span>
            <svg class="gh-stars-logo" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero-inner">
          <h1 class="hero-title">freemkv-flash</h1>
          <div class="hero-badge">
            <span class="hero-badge-dot" aria-hidden="true"></span>
            <span>Beta</span>
          </div>
          <div class="hero-version">
            <span class="hero-version-dot" aria-hidden="true"></span>
            <span class="hero-version-label">Latest release</span>
            <span class="hero-version-num" data-latest-version>{release.tag}</span>
          </div>
          <div class="hero-version-date" data-latest-date>{release.date}</div>
          <div class="hero-version-date"><a href="/docs/flash-changelog/">Changelog</a></div>
          <p class="hero-lead">
            A generic optical-drive flasher and backup tool.{' '}<strong>Not freemkv-specific.</strong>
            <br />
            It flashes and backs up any drive firmware image, for any purpose.
            <br />
            Works with MediaTek and Pioneer.
          </p>
        </div>
      </section>

      <!-- ============ FLASH ============ -->
      <section class="block">
        <div class="section-inner">
          <ol class="steps steps-compact">
            <li class="step">
              <span class="step-num">1</span>
              <span class="step-title">Info</span>
              <span class="step-desc">Identify the drive.</span>
            </li>
            <li class="step">
              <span class="step-num">2</span>
              <span class="step-title">Backup</span>
              <span class="step-desc">Save the stock firmware.</span>
            </li>
            <li class="step">
              <span class="step-num">3</span>
              <span class="step-title">Flash</span>
              <span class="step-desc">Write and verify.</span>
            </li>
            <li class="step">
              <span class="step-num">4</span>
              <span class="step-title">Recovery</span>
              <span class="step-desc">Attempt firmware recovery.</span>
            </li>
          </ol>

          <p>Open the downloaded TAR directly. Flash applies an included intermediate update before the final firmware. A BIN flashes only that image. Recovery writes only the member you select.</p>

          <div class="terminal">
            <div class="terminal-bar" aria-hidden="true">
              <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
              <span class="terminal-title">freemkv-flash</span>
            </div>
            <pre class="terminal-body"><code><span class="c"># 1. Identify the drive first — MediaTek or Pioneer, read-only</span>
<span class="p">$</span> freemkv-flash info &lt;dev&gt;

<span class="c"># 2. Back up before touching anything — saves the drive's firmware to a .tar</span>
<span class="p">$</span> freemkv-flash backup &lt;dev&gt; -o backup.tar

<span class="c"># 3. Eject any disc, then flash (irreversible). Drop --execute to only print the plan;</span>
<span class="c">#    it takes its own pre-flash backup first and reads back to verify</span>
<span class="p">$</span> freemkv-flash flash &lt;dev&gt; -i BU40N_1.00.freemkv.tar --execute --i-understand-risk</code></pre>
          </div>

          <div class="notice">
            <h2 class="notice-title">Info and Backup are safe on any drive</h2>
            <p>
              Info and Backup only read from the drive, so they are safe to run on any drive.
              <br />
              Flash has been tested on a range of MediaTek and Pioneer drives, but use it at
              your own risk: we are not responsible for any drive bricked by this software.
            </p>
          </div>

          <!-- Version picker + detected-platform banner (JS-enhanced); also
               drives the hero "Latest release" badge above. -->
          <FirmwareDownloadToolbar repo={firmwareRepo} />

          <DownloadCards platforms={platforms} repo={firmwareRepo} />
          <p class="dl-note">
            <a href={firmwareReleases} data-all-releases>All releases on GitHub →</a>
            <a href={firmwareRepo}>View on GitHub →</a>
          </p>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="section-inner footer-inner">
        <div class="footer-brand">
          <img src="/freemkv-icon.svg" alt="" width="28" height="28" />
          <span>freemkv</span>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={github}>GitHub</a>
          <a href="https://github.com/freemkv/freemkv/blob/main/LICENSE">License (MIT)</a>
        </nav>
      </div>
      <p class="footer-copy">MIT · Recover 100% of readable data from any optical disc.</p>
    </footer>

    <script is:inline>
      (function () {
        var el = document.querySelector('a.gh-stars');
        if (!el) return;
        var repo = el.dataset.ghRepo;
        var countEl = el.querySelector('[data-gh-stars]');
        if (!repo || !countEl) return;
        var CACHE_KEY = 'freemkv:gh-stars:' + repo;
        var TTL_MS = 60 * 60 * 1000;
        function format(n) {
          if (!isFinite(n) || n < 0) return '';
          if (n < 1000) return String(n);
          var k = n / 1000;
          var s = k < 10 ? k.toFixed(1) : Math.round(k).toString();
          return s.replace(/\.0$/, '') + 'k';
        }
        function show(n) {
          var text = format(n);
          if (!text) return;
          countEl.textContent = text;
          countEl.hidden = false;
          el.setAttribute('aria-label', 'GitHub stars: ' + n.toLocaleString());
        }
        try {
          var raw = localStorage.getItem(CACHE_KEY);
          if (raw) {
            var cached = JSON.parse(raw);
            if (cached && typeof cached.count === 'number') {
              show(cached.count);
              if (Date.now() - cached.ts < TTL_MS) return;
            }
          }
        } catch (e) {}
        fetch('https://api.github.com/repos/' + repo, {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
          .then(function (data) {
            var count = data && data.stargazers_count;
            if (typeof count !== 'number') return;
            show(count);
            try { localStorage.setItem(CACHE_KEY, JSON.stringify({ count: count, ts: Date.now() })); } catch (e) {}
          })
          .catch(function () {});
      })();
    </script>

  </body>
</html>
