---
import { graph, websiteNode, orgNode, webPageNode, breadcrumbNode } from '../../lib/jsonld.mjs';
// Firmware landing page for freemkv.org ("/firmware/").
// Lean menu that fans out to the three single-purpose firmware pages:
// Find (/firmware/find/), Modify (/firmware/modify/), Flash (/firmware/flash/).
// Owns its route directly (NOT part of the Starlight docs collection) so it
// shares the landing/download pages' visual language.
import FirmwareNavDropdown from '../../components/FirmwareNavDropdown.astro';

const title = 'freemkv Firmware';
const description =
  'Find your drive base image, modify it into freemkv firmware, then flash it. Three small tools, one flow.';

const docs = '/docs/overview/';
const github = 'https://github.com/freemkv';

const cards = [
  {
    href: '/firmware/find/',
    step: '1',
    title: 'Find',
    desc: 'Find your drive’s base image by model.',
  },
  {
    href: '/firmware/modify/',
    step: '2',
    title: 'Modify',
    desc: 'Turn a base image into freemkv firmware with freemkv-fw.',
  },
  {
    href: '/firmware/flash/',
    step: '3',
    title: 'Flash',
    desc: 'Write it to the drive with freemkv-flash.',
  },
];
// "Everything other tools do" parity grid. Every entry is backed by
// what freemkv-firmware v0.9.2 actually ships (freemkv-fw levers/features,
// freemkv-flash backup/verify/restore) — never add a capability the tools lack.
// Keep the feature wording in step with modify.astro's fwCapabilities.
import firmwareIndex from '../../data/firmware-index.json';
import pioneerIndex from '../../data/pioneer-firmware-index.json';
const hostedModels = [...firmwareIndex, ...pioneerIndex].filter((d) => d.ready).length;

const parity = [
  { name: 'Back up & restore', detail: 'Every flash starts with a backup of the drive; dump everything readable any time and restore from the backup.' },
  { name: 'Verified flashing', detail: 'The image’s integrity signature is checked before writing; afterwards the drive is read back and re-identified.' },
  { name: 'Downgrade any version', detail: 'Flash any firmware version over any existing one.' },
  { name: 'UHD & Blu-ray unlock', detail: 'Unrestricted opens the drive to read every disc type, including Ultra HD Blu-ray.' },
  { name: 'Region-free', detail: 'RPC-1 across DVD and Blu-ray, or force a specific region.' },
  { name: 'Full rip speed', detail: 'Lift the read-speed / riplock ceiling, or set your own cap.' },
  { name: 'Encryption handshake bypass', detail: 'Content reads back decrypted; the host applies the title keys.' },
  { name: 'Revocation-list skip', detail: 'A revoked-but-genuine host certificate still works (non-destructive).' },
  { name: 'Hosted base images', detail: `Stock OEM firmware for ${hostedModels} drive models, ready to find and download.` },
  { name: 'Stock until switched on', detail: 'Every feature ships at OEM; the drive behaves exactly as stock until you arm one.' },
  { name: 'Windows, macOS & Linux', detail: 'Command-line tools on all three; desktop apps on Windows and macOS.' },
  { name: 'Free & open source', detail: 'MIT-licensed. No license key, no subscription, no disc quota.' },
];
import '../../styles/site.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://freemkv.org/firmware/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://freemkv.org/freemkv-icon.svg" />
    <meta property="og:url" content="https://freemkv.org/firmware/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://freemkv.org/freemkv-icon.svg" />
    <script type="application/ld+json" set:html={graph(webPageNode({ path: '/firmware/', name: title, description, type: 'CollectionPage' }), breadcrumbNode('/firmware/', [['freemkv', '/'], ['Firmware', '/firmware/']]), websiteNode(), orgNode())} />
  </head>
  <body class="page-firmware">
    <!-- ============ STICKY NAV ============ -->
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">
          <img src="/freemkv-icon.svg" alt="" width="32" height="32" />
          <span>freemkv</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={docs}>Docs</a>
          <a href="/download/">Software</a>
          <FirmwareNavDropdown active="landing" />
          <a
            class="nav-discord"
            href="https://discord.gg/yu7xMGTyek"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
          >
            <svg class="nav-discord-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.956-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.956 2.42-2.157 2.42zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.946 2.42-2.157 2.42z"/></svg>
          </a>
          <a
            class="gh-stars"
            href="https://github.com/freemkv/freemkv"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub stars"
            data-gh-repo="freemkv/freemkv"
          >
            <span class="gh-stars-num"><span data-gh-stars hidden></span>★</span>
            <svg class="gh-stars-logo" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero-inner">
          <img class="hero-logo" src="/freemkv-icon.svg" alt="freemkv" width="80" height="80" />
          <h1 class="hero-title">Firmware</h1>
          <p class="hero-lead">
            You <strong>Find</strong> your drive's base image, <strong>Modify</strong> it into freemkv firmware, then <strong>Flash</strong> it.
          </p>
        </div>
      </section>

      <!-- ============ THREE CARDS ============ -->
      <section class="block">
        <div class="section-inner">
          <div class="grid card-grid">
            {cards.map((c) => (
              <a class="card step-card" href={c.href}>
                <span class="step-card-num">{c.step}</span>
                <h2 class="card-title">{c.title}</h2>
                <p class="step-card-desc">{c.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ CAPABILITIES ============ -->
      <section class="block block-alt">
        <div class="section-inner">
          <h2 class="section-title">Everything other tools do — free and open source</h2>
          <p class="section-lead">Downgrade, unlock and flash your drive with free, MIT-licensed tools.</p>
          <div class="grid cap-grid">
            {parity.map((c) => (
              <div class="cap-item" data-status="ready">
                <span class="cap-dot cap-dot-ready" aria-hidden="true"></span>
                <div class="cap-body">
                  <span class="cap-name">{c.name}</span>
                  <span class="cap-detail">{c.detail}</span>
                </div>
              </div>
            ))}
          </div>
          <p class="block-note">Flashing supports MediaTek MT1939 and MT1959 drives; Pioneer drives can be backed up today. See <a href="/firmware/flash/">Flash</a> before writing to a drive.</p>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="section-inner footer-inner">
        <div class="footer-brand">
          <img src="/freemkv-icon.svg" alt="" width="28" height="28" />
          <span>freemkv</span>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={github}>GitHub</a>
          <a href="https://github.com/freemkv/freemkv/blob/main/LICENSE">License (MIT)</a>
        </nav>
      </div>
      <p class="footer-copy">MIT · Recover 100% of readable data from any optical disc.</p>
    </footer>

    <script is:inline>
      // Live GitHub star count for the nav "N★ GitHub" link. Cached in
      // localStorage (1h TTL). On failure the link stays as "★" with no number.
      (function () {
        var el = document.querySelector('a.gh-stars');
        if (!el) return;
        var repo = el.dataset.ghRepo;
        var countEl = el.querySelector('[data-gh-stars]');
        if (!repo || !countEl) return;
        var CACHE_KEY = 'freemkv:gh-stars:' + repo;
        var TTL_MS = 60 * 60 * 1000;
        function format(n) {
          if (!isFinite(n) || n < 0) return '';
          if (n < 1000) return String(n);
          var k = n / 1000;
          var s = k < 10 ? k.toFixed(1) : Math.round(k).toString();
          return s.replace(/\.0$/, '') + 'k';
        }
        function show(n) {
          var text = format(n);
          if (!text) return;
          countEl.textContent = text;
          countEl.hidden = false;
          el.setAttribute('aria-label', 'GitHub stars: ' + n.toLocaleString());
        }
        try {
          var raw = localStorage.getItem(CACHE_KEY);
          if (raw) {
            var cached = JSON.parse(raw);
            if (cached && typeof cached.count === 'number') {
              show(cached.count);
              if (Date.now() - cached.ts < TTL_MS) return;
            }
          }
        } catch (e) {}
        fetch('https://api.github.com/repos/' + repo, {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
          .then(function (data) {
            var count = data && data.stargazers_count;
            if (typeof count !== 'number') return;
            show(count);
            try { localStorage.setItem(CACHE_KEY, JSON.stringify({ count: count, ts: Date.now() })); } catch (e) {}
          })
          .catch(function () {});
      })();
    </script>

  </body>
</html>
