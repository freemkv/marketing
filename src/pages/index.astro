---
// Standalone product landing page for freemkv.org.
// This page owns the "/" route directly (NOT part of the Starlight docs
// collection) so it has full design freedom with none of the docs
// sidebar / TOC / breadcrumb chrome. The docs live under /overview/ etc.
const title = 'freemkv: a composable pipeline for optical-disc video';
const description =
  'MIT Rust toolchain built on one elegant idea: every input and every output is a scheme:// URL you compose — freemkv <source> <dest>. Rip, remux, demux, index, and stream DVD, Blu-ray, and 4K UHD, with AACS/CSS decryption and multi-pass bad-sector recovery built into the pipe.';
const download = '/download/';
const github = 'https://github.com/freemkv';
const docs = '/docs/overview/';
import FirmwareNavDropdown from '../components/FirmwareNavDropdown.astro';
import '../styles/site.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://freemkv.org/freemkv-icon.svg" />
    <meta property="og:url" content="https://freemkv.org/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://freemkv.org/freemkv-icon.svg" />
    <link rel="canonical" href="https://freemkv.org/" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': 'https://freemkv.org/#website',
            url: 'https://freemkv.org/',
            name: 'freemkv',
            description,
            publisher: { '@id': 'https://freemkv.org/#org' },
          },
          {
            '@type': 'Organization',
            '@id': 'https://freemkv.org/#org',
            name: 'freemkv',
            url: 'https://freemkv.org/',
            logo: 'https://freemkv.org/freemkv-icon.svg',
            sameAs: ['https://github.com/freemkv'],
          },
          {
            '@type': 'SoftwareApplication',
            '@id': 'https://freemkv.org/#app',
            name: 'freemkv',
            description,
            applicationCategory: 'MultimediaApplication',
            operatingSystem: 'Windows, macOS, Linux',
            processorRequirements: 'Intel, ARM',
            url: 'https://freemkv.org/',
            downloadUrl: 'https://freemkv.org/download/',
            license: 'https://opensource.org/licenses/MIT',
            isAccessibleForFree: true,
            author: { '@id': 'https://freemkv.org/#org' },
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
          },
        ],
      })}
    />
  </head>
  <body class="page-home">
    <!-- ============ STICKY NAV ============ -->
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">
          <img src="/freemkv-icon.svg" alt="" width="32" height="32" />
          <span>freemkv</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={docs}>Docs</a>
          <a href={download}>Software</a>
          <FirmwareNavDropdown />
          <a
            class="nav-discord"
            href="https://discord.gg/yu7xMGTyek"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
          >
            <svg class="nav-discord-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.956-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.956 2.42-2.157 2.42zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.333.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.157 2.42 0 1.334-.946 2.42-2.157 2.42z"/></svg>
          </a>
          <a
            class="gh-stars"
            href="https://github.com/freemkv/freemkv"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub stars"
            data-gh-repo="freemkv/freemkv"
          >
            <span class="gh-stars-num"><span data-gh-stars hidden></span>★</span>
            <svg class="gh-stars-logo" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero-inner">
          <p class="eyebrow">MIT&nbsp;Licensed · 100%&nbsp;Rust · Rip&nbsp;&amp;&nbsp;Mux</p>
          <img class="hero-logo" src="/freemkv-icon.svg" alt="freemkv" width="96" height="96" />
          <h1 class="hero-title">Own your <span class="hl">movies</span>, not just the&nbsp;discs.</h1>
          <ul class="format-pills" aria-label="Supported disc formats">
            <li class="fmt fmt-uhd">UHD</li>
            <li class="fmt fmt-bd">BD</li>
            <li class="fmt fmt-hddvd">HD&nbsp;DVD</li>
            <li class="fmt fmt-dvd">DVD</li>
          </ul>
          <ul class="aacs-pills" aria-label="Supported AACS versions">
            <li class="aacs">AACS 1.0, 2.0, &amp; 2.1</li>
          </ul>
          <div class="cta-row">
            <a class="btn btn-primary" href={download}>Download latest release</a>
            <a class="btn btn-secondary" href={docs}>Read the docs</a>
            <a class="btn btn-ghost" href={github}>View on GitHub</a>
          </div>
          <p class="hero-foot">Free &amp; open source · Windows, macOS, &amp; Linux · Intel &amp; ARM</p>
        </div>
      </section>

      <!-- ============ FEATURE GRID ============ -->
      <section class="features">
        <div class="section-inner">
          <h2 class="section-title">One pipeline, built on one idea.</h2>
          <div class="grid">
            <article class="card">
              <h3>Bad-sector recovery</h3>
              <p>
                A tolerant <strong>sweep</strong> reads the whole disc and skips past
                unreadable sectors, then <strong>patch</strong> passes retry only the
                damage, multi-attempt, with per-sector timeouts and range bisection.
              </p>
            </article>
            <article class="card">
              <h3>Disc → MKV</h3>
              <p>
                Mux every readable title to a standards-clean MKV: video, audio,
                subtitles, chapters. DVDs (CSS) work out of the box; Blu-ray and 4K&nbsp;UHD
                need <a href="/docs/decryption-keys/">decryption keys</a>.
              </p>
            </article>
            <article class="card">
              <h3>Dissect, don&rsquo;t just rip</h3>
              <p>
                Pull one facet of a title out on its own — every video, audio, or
                subtitle track to its own native file
                (<code>video://</code>, <code>audio://</code>, <code>sub://</code>),
                a chapter sidecar (<code>chapters://</code>), or the whole title
                structure as <code>json://</code>. Or export a play-everywhere <code>mp4://</code> in a single decrypt pass.
              </p>
            </article>
            <article class="card">
              <h3>Open source, single binary</h3>
              <p>
                Pure Rust. Download a prebuilt binary for Windows, macOS, or Linux, or
                build from source. The whole toolchain is licensed <strong>MIT</strong>: run it anywhere, audit it, build on it.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- ============ HOW IT WORKS ============ -->
      <section class="how">
        <div class="section-inner">
          <h2 class="section-title">How it works</h2>
          <p class="section-lead">
            Three composable stages: read everything the drive can recover, then chase
            the rest. <a href="/docs/how-recovery-works/">See how recovery works →</a>
          </p>
          <div class="steps">
            <div class="step">
              <div class="step-num">1</div>
              <h3>Sweep</h3>
              <p>Read the whole disc sequentially. Skip ahead past bad sectors, mark them, never abort.</p>
            </div>
            <div class="step-arrow" aria-hidden="true">→</div>
            <div class="step">
              <div class="step-num">2</div>
              <h3>Patch</h3>
              <p>Come back for the bad ranges with targeted, multi-attempt retries and bisection.</p>
            </div>
            <div class="step-arrow" aria-hidden="true">→</div>
            <div class="step">
              <div class="step-num">3</div>
              <h3>Mux</h3>
              <p>Decrypt and mux the recovered image into a clean, fully-featured MKV.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ SHOWCASE / TERMINAL ============ -->
      <section class="showcase">
        <div class="section-inner">
          <h2 class="section-title section-title--rotate" aria-label="From disc to MKV.">
            <span class="rot rot-1" aria-hidden="true">From disc to MKV.</span>
            <span class="rot rot-2" aria-hidden="true">From ISO to MKV.</span>
            <span class="rot rot-3" aria-hidden="true">From MKV to M2TS.</span>
            <span class="rot rot-4" aria-hidden="true">From disc to ISO.</span>
          </h2>
          <p class="section-lead">
            Open the desktop app, pick the titles and tracks you want, choose a
            format, and press <strong>Rip</strong> — the same engine, in a window.
          </p>
          <!-- The Windows app on its titles page with an image open, which is what
               the copy above promises. Captured on a clean Windows Server 2022
               desktop at 1920x1080, window sized to 1700x980 and cropped to the
               window itself, so there is no wallpaper or capture padding to fight
               `.shot img`'s own border.
               The disc is a SYNTHETIC image built for this shot — a feature plus
               three extras, authored from generated video — so no commercial title
               appears on the page. -->
          <figure class="shot">
            <img
              src="/freemkv-gui-windows.png"
              alt="The freemkv desktop app on Windows with a disc image open — per-title and per-track selection with chapters and durations, output format, and a live log"
              width="1180"
              loading="lazy"
            />
            <figcaption class="shot-caption">
              The freemkv desktop app on Windows. See also the <a href="/docs/platforms-macos/">macOS guide</a>.
            </figcaption>
          </figure>

          <p class="showcase-sub">
            Prefer a command line? The <em>same</em> binary composes a <em>source</em> and a <em>destination</em> URL — no rigid subcommands. Read from a disc,
            ISO, or M2TS; write to MKV, ISO, M2TS, a network stream, or stdout.
          </p>
          <div class="terminal">
            <div class="terminal-bar" aria-hidden="true">
              <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
              <span class="terminal-title">freemkv</span>
            </div>
            <pre class="terminal-body"><code><span class="c"># Rip a disc straight to MKV — the main path (decrypt + mux)</span>
<span class="p">$</span> freemkv disc:// mkv://Movie.mkv

<span class="c"># Remux an existing ISO to MKV — no disc needed, same shape</span>
<span class="p">$</span> freemkv iso://Disc.iso mkv://Movie.mkv

<span class="c"># Index a disc image, or extract its elementary streams</span>
<span class="p">$</span> freemkv iso://Disc.iso fvi://Disc.fvi
<span class="p">$</span> freemkv iso://Disc.iso demux://tracks/

<span class="c"># Pipe decrypted output to another tool over stdout</span>
<span class="p">$</span> freemkv disc:// stdio:// | your-transcoder -i - …</code></pre>
          </div>

          <p class="showcase-sub">Or run the whole thing as a service: insert a disc, get an MKV:</p>
          <div class="terminal terminal-compact">
            <div class="terminal-bar" aria-hidden="true">
              <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
              <span class="terminal-title">autorip</span>
            </div>
            <pre class="terminal-body"><code><span class="c"># Run the autorip binary as a daemon, then open http://&lt;host&gt;:8080</span>
<span class="p">$</span> ./autorip</code></pre>
          </div>
          <p class="showcase-note">
            <code>disc://</code> defaults to the main title; run <code>freemkv info disc://</code> to list every title with durations, or add <code>-t N</code> to pick one. The same <code>--multipass</code> recovery and decryption apply to whichever source and sink
            you compose.
          </p>
          <p class="showcase-note">
            autorip runs on Windows, macOS, and Linux as a single binary (or a Linux container). <a href="/download/">Download autorip</a> · see the <a href="/docs/autorip/">autorip docs</a> for setup and <a href="/docs/decryption-keys/">decryption keys</a> for Blu-ray and 4K&nbsp;UHD.
          </p>
        </div>
      </section>

      <!-- ============ CTA BAND ============ -->
      <section class="cta-band">
        <div class="section-inner cta-band-inner">
          <h2>Get started</h2>
          <p>Grab a prebuilt binary and get started.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href={download}>Download latest release</a>
            <a class="btn btn-secondary" href="/docs/overview/">Read the docs</a>
          </div>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="section-inner footer-inner">
        <div class="footer-brand">
          <img src="/freemkv-icon.svg" alt="" width="28" height="28" />
          <span>freemkv</span>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={github}>GitHub</a>
          <a href="https://github.com/freemkv/autorip/pkgs/container/autorip">GHCR (autorip)</a>
          <a href="https://github.com/freemkv/freemkv/blob/main/LICENSE">License (MIT)</a>
        </nav>
      </div>
      <p class="footer-copy">MIT · Recover 100% of readable data from any optical disc.</p>
    </footer>


    <script>
      // Live GitHub star count for the nav. Fetched client-side and cached in
      // localStorage (1h TTL) to stay under the unauthenticated rate limit
      // (~60 req/hr/IP). No token. On failure, the link stays as just the star
      // icon with no number, never a broken "NaN".
      (() => {
        const el = document.querySelector('a.gh-stars');
        if (!el) return;
        const repo = el.dataset.ghRepo;
        const countEl = el.querySelector('[data-gh-stars]');
        if (!repo || !countEl) return;

        const CACHE_KEY = 'freemkv:gh-stars:' + repo;
        const TTL_MS = 60 * 60 * 1000;

        const format = (n) => {
          if (!Number.isFinite(n) || n < 0) return '';
          if (n < 1000) return String(n);
          const k = n / 1000;
          const s = k < 10 ? k.toFixed(1) : Math.round(k).toString();
          return s.replace(/\.0$/, '') + 'k';
        };

        const show = (n) => {
          const text = format(n);
          if (!text) return;
          countEl.textContent = text;
          countEl.hidden = false;
          el.setAttribute('aria-label', 'GitHub stars: ' + n.toLocaleString());
        };

        try {
          const raw = localStorage.getItem(CACHE_KEY);
          if (raw) {
            const cached = JSON.parse(raw);
            if (cached && typeof cached.count === 'number') {
              show(cached.count);
              if (Date.now() - cached.ts < TTL_MS) return;
            }
          }
        } catch {}

        fetch('https://api.github.com/repos/' + repo, {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((data) => {
            const count = data && data.stargazers_count;
            if (typeof count !== 'number') return;
            show(count);
            try {
              localStorage.setItem(CACHE_KEY, JSON.stringify({ count, ts: Date.now() }));
            } catch {}
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>
