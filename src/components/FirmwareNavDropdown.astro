---
// Shared "Firmware" nav dropdown used by the marketing/tool pages that own
// their own <header> markup (index.astro, download.astro, and the
// src/pages/firmware/* pages). "Firmware" itself links to the overview;
// hover/focus reveals Find, Modify, Flash (Escape closes it).
interface Props {
  active?: 'landing' | 'find' | 'modify' | 'flash' | null;
}
const { active = null } = Astro.props;
const items: Array<{ href: string; label: string; key: 'find' | 'modify' | 'flash' }> = [
  { href: '/firmware/find/', label: 'Find', key: 'find' },
  { href: '/firmware/modify/', label: 'Modify', key: 'modify' },
  { href: '/firmware/flash/', label: 'Flash', key: 'flash' },
];
---

<div class="nav-dropdown" data-nav-dropdown>
  <a
    href="/firmware/"
    class="nav-dropdown-trigger"
    aria-haspopup="true"
    aria-expanded="false"
    aria-current={active ? 'page' : undefined}
  >
    Firmware
    <svg class="nav-dropdown-caret" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
      ><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06z" clip-rule="evenodd"
      ></path></svg>
  </a>
  <div class="nav-dropdown-menu" role="menu">
    {items.map((it) => (
      <a href={it.href} role="menuitem" aria-current={active === it.key ? 'page' : undefined}>{it.label}</a>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll('[data-nav-dropdown]').forEach((wrap) => {
    const link = wrap.querySelector('.nav-dropdown-trigger');
    if (!link) return;
    const sync = () => link.setAttribute('aria-expanded', String(wrap.matches(':hover, :focus-within') && !wrap.classList.contains('dismissed')));
    wrap.addEventListener('mouseenter', sync);
    wrap.addEventListener('mouseleave', () => { wrap.classList.remove('dismissed'); sync(); });
    wrap.addEventListener('focusin', sync);
    wrap.addEventListener('focusout', (e) => {
      if (!wrap.contains(e.relatedTarget)) wrap.classList.remove('dismissed');
      requestAnimationFrame(sync);
    });
    wrap.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        wrap.classList.add('dismissed');
        link.focus();
        sync();
      }
    });
  });
</script>

<style>
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font: inherit;
    font-weight: 550;
    font-size: 0.95rem;
    color: var(--slate);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .nav-dropdown-trigger:hover,
  .nav-dropdown:hover .nav-dropdown-trigger {
    color: var(--teal-dark);
  }
  .nav-dropdown-trigger[aria-current='page'] {
    color: var(--teal-dark);
    font-weight: 650;
  }
  .nav-dropdown-caret {
    width: 0.85em;
    height: 0.85em;
    transition: transform 0.15s ease;
  }
  .nav-dropdown:hover:not(.dismissed) .nav-dropdown-caret,
  .nav-dropdown:focus-within:not(.dismissed) .nav-dropdown-caret {
    transform: rotate(180deg);
  }
  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 160px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 14px 34px -18px rgba(15, 23, 42, 0.35);
    padding: 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.12s ease;
    z-index: 60;
  }
  /* Invisible hover bridge: fills the visual gap between the trigger and the
     menu panel so the pointer never leaves the hover region on the way down. */
  .nav-dropdown-menu::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -0.7rem;
    height: 0.7rem;
  }
  .nav-dropdown:hover:not(.dismissed) .nav-dropdown-menu,
  .nav-dropdown:focus-within:not(.dismissed) .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .nav-dropdown-menu a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 7px;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--slate);
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .nav-dropdown-menu a:hover,
  .nav-dropdown-menu a:focus,
  .nav-dropdown-menu a:focus-visible {
    background: var(--teal-tint, #f0fdfa);
    color: var(--teal-dark);
    text-decoration: none;
  }
  .nav-dropdown-menu a[aria-current='page'] {
    color: var(--teal-dark);
    font-weight: 700;
  }
</style>
