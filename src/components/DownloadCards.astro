---
// Per-OS download cards, one labelled box per install method (Homebrew, APT,
// Snap, a direct download, ...). Shared by /download/, /firmware/flash/ and
// /firmware/modify/. Links use `releases/latest/download/<asset>`; the page
// script rewrites them for a picked version via `data-asset`.
interface Build {
  file: string;
  arch: string;
  label: string;
  main?: string;
  key?: string;
  secondary?: boolean;
}
interface Method {
  title: string;
  hint?: string;
  commands?: string[];
  builds?: Build[];
  note?: string;
}
interface Platform {
  name: string;
  os: string;
  methods: Method[];
  footnote?: string;
}
interface Props {
  platforms: Platform[];
  repo: string;
}
const { platforms, repo } = Astro.props;
---

<div class="grid dl-stack">
  {platforms.map((p) => (
    <article class="card" data-os={p.os} data-platform-card>
      <h3 class="card-title">{p.name}</h3>
      <div class="dl-methods">
        {p.methods.map((m) => (
          <section class="dl-method">
            <h4 class="dl-method-title">
              {m.title}
              {m.hint && <span class="dl-method-hint">{m.hint}</span>}
              {m.commands && m.commands.length > 0 && (
              <button type="button" class="dl-copy" data-copy aria-label="Copy commands" title="Copy">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="dl-copy-done">Copied</span>
              </button>
              )}
            </h4>
            {m.commands && m.commands.length > 0 && (
              <code class="dl-brew-cmd dl-brew-multi">{m.commands.join('\n')}</code>
            )}
            {m.builds && m.builds.length > 0 && (
              <div class="dl-list">
                {m.builds.map((b) => (
                  <a
                    class={`btn ${b.secondary ? 'btn-secondary' : 'btn-primary'} dl-btn`}
                    data-key={b.key}
                    data-asset={b.file}
                    href={`${repo}/releases/latest/download/${b.file}`}
                    download
                  >
                    <span class="dl-main">{b.main ?? 'Download'} <span class="dl-arch">{b.arch}</span></span>
                    <span class="dl-sub">{b.label}</span>
                  </a>
                ))}
              </div>
            )}
            {m.note && <p class="dl-method-note" set:html={m.note} />}
          </section>
        ))}
      </div>
      {p.footnote && <p class="dl-soon-note" set:html={p.footnote} />}
    </article>
  ))}
</div>

<script>
  // Copy a method box's commands; the button flips to "Copied" briefly.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.closest('.dl-method')?.querySelector('code');
      if (!code) return;
      const text = code.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(code);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        document.execCommand('copy');
        sel?.removeAllRanges();
      }
      btn.classList.add('is-copied');
      setTimeout(() => btn.classList.remove('is-copied'), 1500);
    });
  });
</script>
