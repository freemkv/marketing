---
// Per-OS download cards, one labelled box per install method (Homebrew, APT,
// Snap, a direct download, ...). Shared by /download/, /firmware/flash/ and
// /firmware/modify/. Links use `releases/latest/download/<asset>`; the page
// script rewrites them for a picked version via `data-asset`.
interface Build {
  file: string;
  arch: string;
  label: string;
  main?: string;
  key?: string;
  secondary?: boolean;
}
interface Method {
  title: string;
  hint?: string;
  commands?: string[];
  builds?: Build[];
  note?: string;
}
interface Platform {
  name: string;
  os: string;
  methods: Method[];
  footnote?: string;
}
interface Props {
  platforms: Platform[];
  repo: string;
}
const { platforms, repo } = Astro.props;
---

<div class="grid dl-stack">
  {platforms.map((p) => (
    <article class="card" data-os={p.os} data-platform-card>
      <h3 class="card-title">{p.name}</h3>
      <div class="dl-methods">
        {p.methods.map((m) => (
          <section class="dl-method">
            <h4 class="dl-method-title">
              {m.title}
              {m.hint && <span class="dl-method-hint">{m.hint}</span>}
            </h4>
            {m.commands && m.commands.length > 0 && (
              <code class="dl-brew-cmd dl-brew-multi">{m.commands.join('\n')}</code>
            )}
            {m.builds && m.builds.length > 0 && (
              <div class="dl-list">
                {m.builds.map((b) => (
                  <a
                    class={`btn ${b.secondary ? 'btn-secondary' : 'btn-primary'} dl-btn`}
                    data-key={b.key}
                    data-asset={b.file}
                    href={`${repo}/releases/latest/download/${b.file}`}
                    download
                  >
                    <span class="dl-main">{b.main ?? 'Download'} <span class="dl-arch">{b.arch}</span></span>
                    <span class="dl-sub">{b.label}</span>
                  </a>
                ))}
              </div>
            )}
            {m.note && <p class="dl-method-note" set:html={m.note} />}
          </section>
        ))}
      </div>
      {p.footnote && <p class="dl-soon-note" set:html={p.footnote} />}
    </article>
  ))}
</div>
