<button type="button" class="theme-picker" data-theme-toggle data-theme-preference="system" aria-label="Color theme: System. Switch to Light." title="Color theme: System. Switch to Light.">
  <svg data-theme-icon="system" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="13" rx="2"/><path d="M8 21h8m-4-5v5"/></svg>
  <svg data-theme-icon="light" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
  <svg data-theme-icon="dark" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
</button>

<style>
  .theme-picker { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 2.5rem; height: 2.5rem; padding: 0.5rem; color: var(--slate, var(--sl-color-text)); background: transparent; border: 0; border-radius: 8px; cursor: pointer; }
  .theme-picker:hover { color: var(--teal-dark, var(--sl-color-accent)); background: var(--surface, var(--sl-color-bg-nav)); }
  .theme-picker:focus-visible { outline: 2px solid var(--teal-dark, var(--sl-color-accent)); outline-offset: 3px; }
  [data-theme-icon] { display: none; }
  [data-theme-preference="system"] [data-theme-icon="system"],
  [data-theme-preference="light"] [data-theme-icon="light"],
  [data-theme-preference="dark"] [data-theme-icon="dark"] { display: block; }
</style>
