---
// Live freemkv-firmware version. Renders a fallback tag (the latest known
// firmware release) and upgrades it at runtime from the freemkv-firmware
// GitHub "latest release" tag — the same client-side pattern the download page
// uses for the main stack version. When firmware ships a new release the site
// updates automatically; the fallback is only shown if the API can't be reached.
interface Props {
  /** Shown until the live tag loads (and if the fetch fails). */
  fallback?: string;
}
const { fallback = '0.8.1' } = Astro.props;
---

<span class="fw-version" data-fw-version>{fallback}</span>

<script>
  // Hoisted + deduped by Astro, so it runs once per page even if the component
  // is used more than once. Fills every [data-fw-version] with the live tag.
  const nodes = document.querySelectorAll('[data-fw-version]');
  if (nodes.length) {
    const KEY = 'freemkv:fw-version';
    const TTL = 60 * 60 * 1000; // 1h
    const apply = (tag: string) => {
      if (!tag) return;
      const v = String(tag).replace(/^v/, '');
      document
        .querySelectorAll('[data-fw-version]')
        .forEach((el) => (el.textContent = v));
    };
    let cached: { tag?: string; ts?: number } | null = null;
    try {
      cached = JSON.parse(localStorage.getItem(KEY) || 'null');
    } catch {}
    let fresh = false;
    if (cached && cached.tag) {
      apply(cached.tag);
      fresh = Date.now() - (cached.ts || 0) < TTL;
    }
    if (!fresh) {
      fetch(
        'https://api.github.com/repos/freemkv/freemkv-firmware/releases/latest',
        { headers: { Accept: 'application/vnd.github+json' } }
      )
        .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
        .then((rel) => {
          const tag = rel && rel.tag_name;
          if (!tag) return;
          apply(tag);
          try {
            localStorage.setItem(KEY, JSON.stringify({ tag, ts: Date.now() }));
          } catch {}
        })
        .catch(() => {});
    }
  }
</script>
