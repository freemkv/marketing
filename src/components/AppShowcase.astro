---
// Desktop-app screenshots in a labelled frame. No `os` prop: the homepage
// slideshow of every shot. With `os`: that one shot as a thumbnail that opens
// full size in a <dialog> (the platform docs pages).
import { appShots } from '../data/app-screenshots';

interface Props { os?: string }
const { os } = Astro.props;
const one = os ? appShots.find((s) => s.os === os) : undefined;
if (os && !one) throw new Error(`AppShowcase: no screenshot for os="${os}"`);
const slides = one ? [one] : appShots;
---

{one ? (
  <figure class="shot shot--thumb not-content" data-lightbox>
    <button type="button" class="stage thumb" style={`aspect-ratio: ${one.w} / ${one.h}`} aria-haspopup="dialog">
      <img src={one.src} alt={one.alt} width={one.w} height={one.h} loading="lazy" decoding="async" />
      <span class="os-label">{one.label}</span>
    </button>
    <dialog class="lightbox" aria-label={`${one.label} screenshot, full size`}>
      <img src={one.src} alt={one.alt} width={one.w} height={one.h} loading="lazy" decoding="async" />
      <button type="button" class="lightbox-close" aria-label="Close">×</button>
    </dialog>
  </figure>
) : (
  <figure class="shot carousel" data-carousel>
    <div class="stage" aria-roledescription="carousel" aria-label="Desktop app screenshots" aria-live="off">
      {slides.map((s, i) => (
        <div class="slide" data-active={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
          <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        </div>
      ))}
      <span class="os-label" data-label>{slides[0].label}</span>
    </div>
    {slides.length > 1 && (
      <div class="dots" role="group" aria-label="Choose a screenshot">
        {slides.map((s, i) => (
          <button type="button" class="dot-btn" aria-label={`Show ${s.label} screenshot`} aria-current={i === 0 ? 'true' : 'false'} data-label={s.label}></button>
        ))}
      </div>
    )}
    <figcaption class="shot-caption">
      The freemkv desktop app on Windows, macOS and Linux. See the <a href="/docs/platforms-windows/">Windows</a>, <a href="/docs/platforms-macos/">macOS</a> and <a href="/docs/platforms-linux/">Linux</a> guides.
    </figcaption>
  </figure>
)}

<style>
  .stage {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    width: 100%;
    padding: 0;
    margin: 0;
    overflow: hidden;
    background: #0f172a;
    border-radius: var(--radius, 14px);
    border: 1px solid #1e293b;
    box-shadow: 0 24px 60px -28px rgba(15, 23, 42, 0.55);
  }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.6s ease; }
  .slide[data-active] { opacity: 1; }
  .stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .os-label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 1;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.8);
    color: #fff;
    font: 600 0.75rem/1.4 var(--font, system-ui, sans-serif);
    pointer-events: none;
  }
  .dots { display: flex; justify-content: center; gap: 0.5rem; margin-top: 0.75rem; }
  .dot-btn {
    width: 0.65rem;
    height: 0.65rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--muted, #64748b);
    background: transparent;
    cursor: pointer;
  }
  .dot-btn[aria-current='true'] { background: var(--muted, #64748b); }
  .dot-btn:focus-visible, .thumb:focus-visible { outline: 2px solid var(--teal, #0d9488); outline-offset: 2px; }

  .shot--thumb { max-width: 480px; margin: 1.5rem 0; }
  .thumb { cursor: zoom-in; box-shadow: 0 16px 40px -24px rgba(15, 23, 42, 0.55); }
  .lightbox {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 90vw;
    max-height: 90vh;
    overflow: visible;
  }
  .lightbox::backdrop { background: rgba(2, 6, 23, 0.8); }
  .lightbox img {
    display: block;
    width: auto;
    height: auto;
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
  }
  .lightbox-close {
    position: absolute;
    top: -0.9rem;
    right: -0.9rem;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid #334155;
    background: #0f172a;
    color: #fff;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] { animation: lb-in 0.18s ease-out; }
    @keyframes lb-in { from { opacity: 0; transform: scale(0.97); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .slide { transition: none; }
  }
</style>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-lightbox]').forEach((fig) => {
      const thumb = fig.querySelector('.thumb');
      const dlg = fig.querySelector('dialog');
      if (!thumb || !dlg || !dlg.showModal) return;
      thumb.addEventListener('click', () => dlg.showModal());
      dlg.querySelector('.lightbox-close').addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('close', () => thumb.focus({ preventScroll: true }));
    });

    const root = document.querySelector('[data-carousel]');
    if (!root) return;
    const stage = root.querySelector('.stage');
    const slides = [...root.querySelectorAll('.slide')];
    const dots = [...root.querySelectorAll('.dot-btn')];
    const label = root.querySelector('[data-label]');
    if (slides.length < 2) return;
    let cur = 0;
    let timer = null;
    const show = (n) => {
      cur = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.toggleAttribute('data-active', i === cur);
        if (i === cur) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === cur)));
      label.textContent = dots[cur].dataset.label;
    };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) stage.setAttribute('aria-live', 'polite');
    const stop = () => { clearInterval(timer); timer = null; stage.setAttribute('aria-live', 'polite'); };
    const start = () => {
      if (reduced || timer) return;
      stage.setAttribute('aria-live', 'off');
      timer = setInterval(() => show(cur + 1), 5000);
    };
    dots.forEach((d, i) => d.addEventListener('click', () => { stop(); show(i); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', () => { if (!root.contains(document.activeElement)) start(); });
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget) && !root.matches(':hover')) start(); });
    start();
  })();
</script>
