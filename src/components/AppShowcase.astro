---
// Desktop-app screenshots in a labelled frame. No `os` prop: the homepage
// slideshow of each OS's featured shot. With `os`: every shot for that OS as a
// row of thumbnails; each opens full size in one <dialog> lightbox with
// previous/next buttons and arrow keys (the platform docs pages).
import { appShots, featuredShots, shotsFor } from '../data/app-screenshots';

interface Props { os?: string }
const { os } = Astro.props;
const gallery = os ? shotsFor(os) : [];
if (os && !gallery.length) throw new Error(`AppShowcase: no screenshot for os="${os}"`);
const slides = featuredShots;
const oses = [...new Set(appShots.map((s) => s.os))];
if (slides.length !== oses.length || new Set(slides.map((s) => s.os)).size !== oses.length)
  throw new Error('AppShowcase: mark exactly one `featured` shot per OS in app-screenshots.ts');
const first = gallery[0];
---

{os ? (
  <figure class:list={['shot', 'shot--gallery', 'not-content', { 'shot--single': gallery.length === 1 }]} data-lightbox>
    <ul class="thumbs" role="list">
      {gallery.map((s, i) => (
        <li>
          <button
            type="button"
            class="stage thumb"
            style={gallery.length === 1 ? `aspect-ratio: ${s.w} / ${s.h}` : undefined}
            aria-haspopup="dialog"
            data-src={s.src}
            data-alt={s.alt}
            data-w={s.w}
            data-h={s.h}
          >
            <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" />
            <span class="os-label">{s.label}</span>
          </button>
        </li>
      ))}
    </ul>
    <dialog class="lightbox" aria-label={`${first.label} screenshots, full size`}>
      <img src={first.src} alt={first.alt} width={first.w} height={first.h} loading="lazy" decoding="async" data-full />
      {gallery.length > 1 && (
        <>
          <button type="button" class="lightbox-nav lightbox-prev" aria-label="Previous screenshot" data-step="-1">‹</button>
          <button type="button" class="lightbox-nav lightbox-next" aria-label="Next screenshot" data-step="1">›</button>
          <span class="lightbox-count" aria-live="polite" data-count>1 / {gallery.length}</span>
        </>
      )}
      <button type="button" class="lightbox-close" aria-label="Close">×</button>
    </dialog>
  </figure>
) : (
  <figure class="shot carousel" data-carousel>
    <div class="stage" aria-roledescription="carousel" aria-label="Desktop app screenshots" aria-live="off">
      {slides.map((s, i) => (
        <div class="slide" data-active={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
          <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        </div>
      ))}
      <span class="os-label" data-label>{slides[0].label}</span>
    </div>
    {slides.length > 1 && (
      <div class="dots" role="group" aria-label="Choose a screenshot">
        {slides.map((s, i) => (
          <button type="button" class="dot-btn" aria-label={`Show ${s.label} screenshot`} aria-current={i === 0 ? 'true' : 'false'} data-label={s.label}></button>
        ))}
      </div>
    )}
    <figcaption class="shot-caption">
      The freemkv desktop app on Windows, macOS and Linux. See the <a href="/docs/platforms-windows/">Windows</a>, <a href="/docs/platforms-macos/">macOS</a> and <a href="/docs/platforms-linux/">Linux</a> guides.
    </figcaption>
  </figure>
)}

<style>
  .stage {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    width: 100%;
    padding: 0;
    margin: 0;
    overflow: hidden;
    background: #0f172a;
    border-radius: var(--radius, 14px);
    border: 1px solid #1e293b;
    box-shadow: 0 24px 60px -28px rgba(15, 23, 42, 0.55);
  }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.6s ease; }
  .slide[data-active] { opacity: 1; }
  .stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .os-label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 1;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.8);
    color: #fff;
    font: 600 0.75rem/1.4 var(--font, system-ui, sans-serif);
    pointer-events: none;
  }
  .dots { display: flex; justify-content: center; gap: 0.5rem; margin-top: 0.75rem; }
  .dot-btn {
    width: 0.65rem;
    height: 0.65rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--muted, #64748b);
    background: transparent;
    cursor: pointer;
  }
  .dot-btn[aria-current='true'] { background: var(--muted, #64748b); }
  .dot-btn:focus-visible, .thumb:focus-visible { outline: 2px solid var(--teal, #0d9488); outline-offset: 2px; }

  .shot--gallery { margin: 1.5rem 0; }
  .thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .thumbs li { margin: 0; padding: 0; }
  .shot--single { max-width: 480px; }
  .shot--single .thumbs { grid-template-columns: 1fr; }
  .thumb { cursor: zoom-in; box-shadow: 0 16px 40px -24px rgba(15, 23, 42, 0.55); }
  .lightbox {
    position: fixed;
    inset: 0;
    margin: auto;
    width: fit-content;
    height: fit-content;
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 90vw;
    max-height: 90vh;
    overflow: visible;
  }
  .lightbox::backdrop { background: rgba(2, 6, 23, 0.8); }
  .lightbox img {
    display: block;
    width: auto;
    height: auto;
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
  }
  .lightbox-close {
    position: absolute;
    top: -0.9rem;
    right: -0.9rem;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid #334155;
    background: #0f172a;
    color: #fff;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid #334155;
    background: rgba(15, 23, 42, 0.85);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-prev { left: 0.75rem; }
  .lightbox-next { right: 0.75rem; }
  .lightbox-count {
    position: absolute;
    left: 50%;
    bottom: 0.75rem;
    transform: translateX(-50%);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.8);
    color: #fff;
    font: 600 0.75rem/1.4 var(--font, system-ui, sans-serif);
  }
  .lightbox-nav:focus-visible, .lightbox-close:focus-visible { outline: 2px solid var(--teal, #0d9488); outline-offset: 2px; }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] { animation: lb-in 0.18s ease-out; }
    @keyframes lb-in { from { opacity: 0; transform: scale(0.97); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .slide { transition: none; }
  }
</style>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-lightbox]').forEach((fig) => {
      const thumbs = [...fig.querySelectorAll('.thumb')];
      const dlg = fig.querySelector('dialog');
      if (!thumbs.length || !dlg || !dlg.showModal) return;
      const full = dlg.querySelector('[data-full]');
      const count = dlg.querySelector('[data-count]');
      let cur = 0;
      const show = (n) => {
        cur = (n + thumbs.length) % thumbs.length;
        const t = thumbs[cur].dataset;
        full.src = t.src;
        full.alt = t.alt;
        full.width = Number(t.w);
        full.height = Number(t.h);
        if (count) count.textContent = `${cur + 1} / ${thumbs.length}`;
      };
      thumbs.forEach((t, i) => t.addEventListener('click', () => { show(i); dlg.showModal(); }));
      dlg.querySelectorAll('[data-step]').forEach((b) =>
        b.addEventListener('click', () => show(cur + Number(b.dataset.step))));
      dlg.addEventListener('keydown', (e) => {
        if (thumbs.length < 2) return;
        if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1); }
      });
      dlg.querySelector('.lightbox-close').addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('close', () => thumbs[cur].focus({ preventScroll: true }));
    });

    const root = document.querySelector('[data-carousel]');
    if (!root) return;
    const stage = root.querySelector('.stage');
    const slides = [...root.querySelectorAll('.slide')];
    const dots = [...root.querySelectorAll('.dot-btn')];
    const label = root.querySelector('[data-label]');
    if (slides.length < 2) return;
    let cur = 0;
    let timer = null;
    const show = (n) => {
      cur = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.toggleAttribute('data-active', i === cur);
        if (i === cur) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === cur)));
      label.textContent = dots[cur].dataset.label;
    };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) stage.setAttribute('aria-live', 'polite');
    const stop = () => { clearInterval(timer); timer = null; stage.setAttribute('aria-live', 'polite'); };
    const start = () => {
      if (reduced || timer) return;
      stage.setAttribute('aria-live', 'off');
      timer = setInterval(() => show(cur + 1), 5000);
    };
    dots.forEach((d, i) => d.addEventListener('click', () => { stop(); show(i); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', () => { if (!root.contains(document.activeElement)) start(); });
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget) && !root.matches(':hover')) start(); });
    start();
  })();
</script>
